---
/**
 * "More" bottom-sheet — houses secondary destinations that don't fit the
 * 5-item BottomNav, plus the language toggle and (confirmed) logout.
 *
 * Opened by the "More" item in BottomNav (button#more-nav-btn). Role-aware:
 * kids get a short list, parents get the full management surface. Several of
 * these pages (meals, shopping, calendar, dm) previously had NO nav entry
 * anywhere — this is their first discoverable home.
 */
import Icon from "./ui/Icon.astro";
import type { IconName } from "../lib/icons";
import { t } from "../lib/i18n";

interface Props {
    role?: string;
    lang?: string;
    unread?: number;
    /** Family module registry from /auth/me (null = all modules on). */
    modules?: string[] | null;
    /** Operator flag from /auth/me. Only ever true for the caller themselves —
     *  strip_superadmin_flag() blanks it on any UserResponse describing someone
     *  else, so this cannot leak sideways to a co-parent or a kid. */
    isSuperadmin?: boolean;
}
const { role = "child", lang = "en", unread = 0, modules = null, isSuperadmin = false } = Astro.props;
const es = lang === "es";
const isParent = role === "parent";
const isTeen = role === "teen";
const nextLang = es ? "en" : "es";

type Link = { href: string; label: string; icon: IconName; badge?: number };

const inbox: Link = { href: "/notifications", label: es ? "Avisos" : "Inbox", icon: "bell", badge: unread };

const help: Link = { href: es ? "/ayuda" : "/help", label: es ? "Ayuda" : "Help", icon: "help" };

// Per-family module registry (BottomNav fetches /auth/me and forwards it).
// null = all on. Links tied to a disabled module disappear from the sheet.
const mod = (k: string) => modules == null || modules.includes(k);

const kidLinks: Link[] = [
    inbox,
    { href: "/routines", label: es ? "Rutinas" : "Routines", icon: "routines" },
    // Teens (paid plan) get a read-only self-coach; children do not. The page
    // + API enforce the ai_features plan gate, so an unentitled teen sees an
    // upsell rather than a broken chat.
    ...(isTeen ? [{ href: "/parent/jarvis", label: "Jarvis", icon: "jarvis" } as Link] : []),
    // Support assistant: parents & teens only (children excluded — the
    // backend gate is require_teen_or_parent). NOT premium-gated.
    ...(isTeen ? [{ href: "/soporte", label: es ? "Soporte" : "Support", icon: "support" } as Link] : []),
    ...(mod("pet") ? [{ href: "/pet", label: es ? "Mascota" : "Pet", icon: "pet" } as Link] : []),
    ...(mod("meals") ? [{ href: "/meals", label: es ? "Comidas" : "Meals", icon: "meals" } as Link] : []),
    ...(mod("shopping") ? [{ href: "/shopping", label: es ? "Compras" : "Shopping", icon: "shopping" } as Link] : []),
    ...(mod("calendar") ? [{ href: "/calendar", label: es ? "Calendario" : "Calendar", icon: "calendar" } as Link] : []),
    ...(mod("chat") ? [{ href: "/dm", label: es ? "Mensajes" : "Messages", icon: "dm" } as Link] : []),
    { href: "/profile", label: t(lang, "nav_profile") as string, icon: "profile" } as Link,
    help,
];

const parentLinks: Link[] = [
    inbox,
    { href: "/parent/tasks", label: es ? "Tareas" : "Tasks", icon: "tasks" },
    { href: "/parent/routines", label: es ? "Rutinas" : "Routines", icon: "routines" },
    { href: "/parent/members", label: es ? "Miembros" : "Members", icon: "members" },
    { href: "/parent/rewards", label: t(lang, "nav_rewards") as string, icon: "rewards" },
    { href: "/parent/consequences", label: es ? "Consecuencias" : "Consequences", icon: "consequences" },
    ...(mod("gigs") ? [{ href: "/parent/payouts", label: es ? "Pagos" : "Payouts", icon: "payouts" } as Link] : []),
    { href: "/parent/assignments", label: es ? "Asignaciones" : "Assignments", icon: "assignments" },
    { href: "/parent/day", label: es ? "Día a día" : "Day review", icon: "calendar" },
    { href: "/parent/analytics", label: es ? "Análisis" : "Analytics", icon: "analytics" },
    { href: "/parent/jarvis", label: "Jarvis", icon: "jarvis" },
    { href: "/soporte", label: es ? "Soporte" : "Support", icon: "support" },
    ...(mod("chat") ? [
        { href: "/chat", label: "Chat", icon: "chat" } as Link,
        { href: "/dm", label: es ? "Mensajes" : "Messages", icon: "dm" } as Link,
    ] : []),
    ...(mod("meals") ? [{ href: "/meals", label: es ? "Comidas" : "Meals", icon: "meals" } as Link] : []),
    ...(mod("shopping") ? [{ href: "/shopping", label: es ? "Compras" : "Shopping", icon: "shopping" } as Link] : []),
    ...(mod("calendar") ? [{ href: "/calendar", label: es ? "Calendario" : "Calendar", icon: "calendar" } as Link] : []),
    { href: "/parent/kiosk", label: "Kiosk", icon: "kiosk" },
    { href: "/parent/settings", label: es ? "Ajustes" : "Settings", icon: "settings" },
    // Platform operator console. Rendered only for the operator themselves —
    // the surface 404s for everyone else, so showing the link to a normal
    // parent would just be a dead end that also hints the surface exists.
    ...(isSuperadmin ? [{
        href: "/admin",
        label: es ? "Consola de operador" : "Operator console",
        icon: "operator",
    } as Link] : []),
    { href: "/profile", label: t(lang, "nav_profile") as string, icon: "profile" } as Link,
    help,
];

const links = isParent ? parentLinks : kidLinks;
---

<div id="more-backdrop" class="fixed inset-0 bg-black/50 z-[55] hidden opacity-0 transition-opacity duration-300"></div>

<div
    id="more-sheet"
    role="dialog"
    aria-modal="true"
    aria-hidden="true"
    inert
    aria-label={es ? "Más opciones" : "More options"}
    class="fixed bottom-0 left-0 right-0 z-[60] translate-y-full transition-transform duration-300 ease-out"
>
    <div class="max-w-md mx-auto bg-brand-cream rounded-t-[var(--radius-card)] border-t-2 border-brand-ink shadow-[var(--shadow-stamp)] max-h-[80vh] overflow-y-auto safe-area-bottom">
        <div class="flex justify-center pt-3 pb-1"><div class="w-10 h-1 bg-brand-cream-deep rounded-full"></div></div>
        <div class="flex items-center justify-between px-5 pt-1 pb-3">
            <h2 class="text-lg font-bold text-brand-ink">{es ? "Más" : "More"}</h2>
            <button type="button" id="more-close" class="text-brand-ink-soft hover:text-brand-ink p-2.5 -m-1" aria-label={es ? "Cerrar" : "Close"}>
                <Icon name="close" class="h-6 w-6" />
            </button>
        </div>

        <div class="grid grid-cols-3 gap-2 px-4 pb-3">
            {links.map((l) => (
                <a href={l.href} class="relative flex flex-col items-center justify-center gap-1.5 rounded-2xl bg-brand-cream-deep/60 hover:bg-brand-cream-deep p-3 text-center transition-colors">
                    {(l.badge ?? 0) > 0 && (
                        <span class="absolute top-1.5 right-1.5 min-w-[18px] h-[18px] px-1 flex items-center justify-center bg-brand-coral text-brand-ink text-[10px] font-bold rounded-full">
                            {l.badge! > 99 ? "99+" : l.badge}
                        </span>
                    )}
                    <Icon name={l.icon} class="h-6 w-6 text-brand-ink" />
                    <span class="text-[11px] font-semibold text-brand-ink leading-tight">{l.label}</span>
                </a>
            ))}
        </div>

        <div class="flex gap-2 px-4 pb-5 pt-2 border-t border-brand-ink/10">
            <form method="POST" action="/api/lang" class="flex-1">
                <input type="hidden" name="lang" value={nextLang} />
                <button type="submit" class="w-full flex items-center justify-center gap-2 py-2.5 rounded-xl bg-brand-cream-deep text-brand-ink font-semibold text-sm hover:bg-brand-cream-deep/80 transition-colors">
                    <Icon name="language" class="h-5 w-5" />
                    {es ? "English" : "Español"}
                </button>
            </form>
            <!-- Confirm logout so an accidental tap on a shared tablet doesn't force a full re-login. -->
            <form
                method="POST"
                action="/api/auth/logout"
                class="flex-1"
                data-logout-form
                data-confirm-sheet={es ? "¿Cerrar sesión?" : "Log out?"}
                data-confirm-label={es ? "Cerrar sesión" : "Log out"}
            >
                <input type="hidden" name="action" value="logout" />
                <button type="submit" class="w-full flex items-center justify-center gap-2 py-2.5 rounded-xl border border-red-300 text-red-700 font-semibold text-sm hover:bg-red-50 transition-colors">
                    <Icon name="logout" class="h-5 w-5" />
                    {t(lang, "nav_logout")}
                </button>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener("astro:page-load", () => {
        const backdrop = document.getElementById("more-backdrop");
        const sheet = document.getElementById("more-sheet");
        const openBtn = document.getElementById("more-nav-btn");
        const closeBtn = document.getElementById("more-close");
        if (!backdrop || !sheet || !openBtn) return;

        const open = () => {
            // Remove inert/aria-hidden so the sheet is focusable + announced
            // ONLY while open — otherwise its ~15 off-screen links sit in the
            // tab order and screen readers announce a phantom open modal.
            sheet.removeAttribute("inert");
            sheet.removeAttribute("aria-hidden");
            openBtn.setAttribute("aria-expanded", "true");
            backdrop.classList.remove("hidden");
            requestAnimationFrame(() => {
                backdrop.classList.remove("opacity-0");
                backdrop.classList.add("opacity-100");
                sheet.classList.remove("translate-y-full");
            });
            closeBtn?.focus();
        };
        const close = () => {
            backdrop.classList.remove("opacity-100");
            backdrop.classList.add("opacity-0");
            sheet.classList.add("translate-y-full");
            openBtn.setAttribute("aria-expanded", "false");
            setTimeout(() => {
                backdrop.classList.add("hidden");
                sheet.setAttribute("inert", "");
                sheet.setAttribute("aria-hidden", "true");
            }, 300);
            openBtn.focus();
        };

        openBtn.addEventListener("click", (e) => { e.preventDefault(); open(); });
        closeBtn?.addEventListener("click", close);
        backdrop.addEventListener("click", close);
        // The wrapper spans the full viewport width (z-60, above the backdrop)
        // while the card is max-w-md centered — on desktop, clicks beside the
        // card land here, not on the backdrop. Treat them as outside-clicks.
        sheet.addEventListener("click", (e) => {
            if (e.target === sheet) close();
        });
        document.addEventListener("keydown", (e) => {
            if (e.key === "Escape" && !backdrop.classList.contains("hidden")) close();
        });

        // Trap Tab within the sheet while open (background is not inert).
        sheet.addEventListener("keydown", (e) => {
            if (e.key !== "Tab") return;
            const f = sheet.querySelectorAll<HTMLElement>('a[href], button:not([disabled])');
            if (!f.length) return;
            const first = f[0], last = f[f.length - 1];
            if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
            else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
        });
    });
</script>
