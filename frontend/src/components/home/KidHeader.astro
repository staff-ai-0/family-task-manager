---
/** Kid home header (UX-C1): greeting, balance pill, weekly pay meter. */
import type { PayMeter } from "../../lib/kidHome";
import { headerToneClass } from "../../lib/headerTone";
import type { ProgressView } from "../../lib/progress";

interface Props {
    name: string;
    lang: "en" | "es";
    skin: "teen" | "child";
    starMode: boolean;
    cashCents: number;
    points: number;
    meter: PayMeter;
    counter: { done: number; total: number; suffix: string };
    progress?: ProgressView | null;
}
const { name, lang, skin, starMode, cashCents, points, meter, counter, progress = null } = Astro.props;
const es = lang === "es";
const money = (cents: number) =>
    `$${Math.round(cents / 100).toLocaleString(es ? "es-MX" : "en-US")}`;
// Teen keeps its dark skin; the child skin is the sky section tone (ink text, 6.5:1).
const skinClass = skin === "teen" ? "bg-[#1E2230] text-white" : headerToneClass("sky");
const pillCls = skin === "teen" ? "bg-white/10 border-white/25" : "bg-white/40 border-brand-ink/20";
const trackCls = skin === "teen" ? "bg-white/15" : "bg-brand-ink/15";
const fillCls = skin === "teen" ? "bg-brand-mint" : "bg-brand-ink";
---

<header class={`${skinClass} pt-12 pb-5 px-6 rounded-b-[var(--radius-tile)] shadow-[var(--shadow-card)]`}>
    <div class="flex items-center justify-between gap-3">
        <div class="min-w-0">
            <p class="text-xs">{es ? "Hola," : "Hi,"}</p>
            <h1 class="text-2xl font-extrabold leading-tight truncate">{name}</h1>
        </div>
        <a
            href={starMode ? "/rewards" : "/bank"}
            data-points-badge={starMode ? "" : undefined}
            class="shrink-0 rounded-full bg-white/15 border border-white/25 px-3 py-1.5 text-sm font-extrabold"
        >
            {starMode ? `⭐ ${points}` : money(cashCents)}
        </a>
    </div>
    {progress && (
        <div class="mt-2" data-progress-row data-skin={skin} data-lang={lang}>
            <div class="flex flex-wrap gap-2">
                <button type="button" data-progress-open data-progress-streak aria-haspopup="dialog"
                        class={`rounded-full border px-3 py-1 text-xs font-extrabold ${pillCls}`}>
                    {progress.streakLabel}
                </button>
                <button type="button" data-progress-open data-progress-rank aria-haspopup="dialog"
                        class={`rounded-full border px-3 py-1 text-xs font-extrabold ${pillCls}`}>
                    {progress.rankLabel}
                </button>
            </div>
            <div class={`mt-2 h-1.5 rounded-full overflow-hidden ${trackCls}`} role="img"
                 aria-label={progress.toNextLabel} data-progress-bar>
                <div class={`h-full ${fillCls}`} style={`width:${progress.barPct}%`}></div>
            </div>
        </div>
    )}
    {meter.show && (
        <div class="mt-4 rounded-2xl bg-white/10 border border-white/15 px-4 py-3">
            <div class="flex justify-between gap-2 text-[11px]">
                <span>💵 {es ? "Pago de la semana" : "This week's pay"} · {es ? "meta" : "goal"} {money(meter.capCents)}</span>
                {counter.total > 0 && (
                    <span data-today-counter data-done={counter.done} data-total={counter.total} data-suffix={counter.suffix}>
                        {counter.done}/{counter.total} {counter.suffix}
                    </span>
                )}
            </div>
            <div
                class="mt-2 h-2 rounded-full bg-white/15 flex overflow-hidden"
                role="img"
                aria-label={es ? "Avance de tu pago de la semana" : "Progress toward this week's pay"}
            >
                <div class="h-full bg-brand-mint-deep" style={`width:${meter.greenPct}%`}></div>
                <div class="h-full bg-red-400" style={`width:${meter.redPct}%`}></div>
            </div>
            {meter.released && (
                <p class="text-[11px] mt-1.5">{es ? "¡Pago de esta semana liberado! 🎉" : "This week's pay is released! 🎉"}</p>
            )}
        </div>
    )}
</header>

<script>
    // F4: TaskDeck dispatches "ftm:deck-empty" (bubbles) when the day's deck
    // is finished, with no page reload — the streak/rank pills, XP bar and
    // ProgressSheet's streak heading otherwise go stale until the kid
    // navigates away and back. This re-fetches the same view the SSR page
    // used and re-renders it client-side; it never re-runs the rank-up
    // celebration (that's ack'd server-side and only ever shows once).
    import { progressDomUpdate, progressView, type Skin } from "../../lib/progress";

    async function refreshProgress() {
        const row = document.querySelector<HTMLElement>("[data-progress-row]");
        if (!row) return;
        const skin = row.dataset.skin as Skin | undefined;
        const lang = row.dataset.lang as "es" | "en" | undefined;
        if (!skin || !lang) return;
        try {
            const res = await fetch("/api/progress/me", { credentials: "same-origin" });
            if (!res.ok) return;
            const view = progressView(await res.json(), skin, lang);
            if (!view) return;
            const u = progressDomUpdate(view);
            const streakEl = row.querySelector("[data-progress-streak]");
            const rankEl = row.querySelector("[data-progress-rank]");
            const barEl = row.querySelector<HTMLElement>("[data-progress-bar]");
            if (streakEl) streakEl.textContent = u.streak;
            if (rankEl) rankEl.textContent = u.rank;
            if (barEl) {
                barEl.setAttribute("aria-label", u.barAriaLabel);
                const fill = barEl.firstElementChild as HTMLElement | null;
                if (fill) fill.style.width = `${u.barWidthPct}%`;
            }
            const sheetStreak = document.querySelector("[data-progress-sheet-streak]");
            if (sheetStreak) sheetStreak.textContent = u.sheetStreak;
        } catch {
            // Best-effort refresh — keep whatever the SSR page already
            // rendered rather than surface an error to the kid.
        }
    }

    window.addEventListener("ftm:deck-empty", refreshProgress);
</script>
