---
import PageLayout from "@components/ui/PageLayout.astro";
import { apiFetch } from "../../lib/api";
import { fmtDate as fmtTzDate } from "../../lib/datetime";

const token = Astro.cookies.get("access_token")?.value;
if (!token) return Astro.redirect("/login");
const lang = (Astro.cookies.get("lang")?.value ?? "es") as "en" | "es";

const { data: user } = await apiFetch<any>("/api/auth/me", { token });
if (!user) {
    Astro.cookies.delete("access_token", { path: "/" });
    return Astro.redirect("/login");
}
if (user.role !== "parent") return Astro.redirect("/dashboard");

const { data: kidsData } = await apiFetch<any[]>("/api/cash/family", { token });
const kids: any[] = Array.isArray(kidsData) ? kidsData : [];
const fmt = (cents: number) => `$${(cents / 100).toFixed(2)}`;

// Aggregate owed: gig cash pending + every unreleased chore-paycheck week
// (not just this week's — outstanding_* totals include the full backlog).
const { data: summary } = await apiFetch<any>("/api/bank/payout-summary", { token });
const cashTotal = summary?.cash_total_cents ?? 0;
const paycheckTotal = summary?.outstanding_paycheck_total_cents ?? 0;
const grandTotal = summary?.outstanding_grand_total_cents ?? 0;
// Kids with at least one outstanding week (current week is always present
// for any chore-based mode, so this matches "not flat mode" in practice —
// plus it naturally surfaces backlog weeks too).
const paycheckKids: any[] = (summary?.kids ?? []).filter(
    (k: any) => (k.outstanding_weeks ?? []).length > 0,
);

// Per-task chips under each paycheck row (hover/tap for details).
const chipCls: Record<string, string> = {
    credited: "bg-brand-mint/20 border-brand-mint-deep/40 text-brand-mint-deep",
    pending_review: "bg-amber-100 border-amber-300 text-amber-800",
    missed: "bg-red-100 border-red-300 text-red-700",
    not_done: "bg-brand-ink/5 border-brand-ink/15 text-brand-ink-soft",
};
const chipIcon: Record<string, string> = {
    credited: "✓",
    pending_review: "⏳",
    missed: "✗",
    not_done: "·",
};
const statusLabel = (t: any): string => {
    if (t.status === "credited") {
        const base = lang === "es" ? "Completada ✓" : "Completed ✓";
        return t.grade === "partial"
            ? `${base} · ${lang === "es" ? "parcial" : "partial"} ${t.partial_credit_pct}%`
            : base;
    }
    if (t.status === "pending_review")
        return lang === "es" ? "Esperando revisión" : "Awaiting review";
    if (t.status === "missed") return lang === "es" ? "No cumplida" : "Missed";
    return lang === "es" ? "Sin hacer" : "Not done yet";
};
const dayLabel = (iso: string): string =>
    new Date(`${iso}T00:00:00`).toLocaleDateString(lang === "es" ? "es-MX" : "en-US", {
        weekday: "short",
        day: "numeric",
        month: "short",
    });
---

<PageLayout
    title={lang === "es" ? "Pagos" : "Payouts"}
    headerClass="bg-gradient-to-br from-emerald-800 to-emerald-600"
    dark
    role="parent"
    active="parent"
    lang={lang}
>
    <div class="px-4 py-5 space-y-4">
        {/* Grand total — everything currently owed to the kids. */}
        <div
            class="rounded-2xl bg-gradient-to-br from-emerald-700 to-emerald-600 text-white p-5 shadow-[var(--shadow-card)]"
            data-owed-header
            data-cash-cents={cashTotal}
            data-paycheck-cents={paycheckTotal}
        >
            <p class="text-[11px] font-semibold uppercase tracking-wider text-emerald-100">
                💵 {lang === "es" ? "Total por pagar a los kids" : "Total owed to the kids"}
            </p>
            <p class="text-4xl font-extrabold tracking-tight" data-grand-total>{fmt(grandTotal)}</p>
            <p class="text-xs text-emerald-100 mt-1">
                {lang === "es" ? "Gigs" : "Gigs"} <span class="font-bold" data-cash-total>{fmt(cashTotal)}</span>
                {" · "}
                {lang === "es" ? "Cheques de tareas" : "Chore paychecks"} <span class="font-bold" data-paycheck-total>{fmt(paycheckTotal)}</span>
            </p>
        </div>

        <h2 class="text-sm font-bold text-brand-ink pt-1">
            💼 {lang === "es" ? "Cash de gigs" : "Gig cash"}
        </h2>
        <p class="text-sm text-brand-ink-soft">
            {lang === "es"
                ? "El dinero que los kids ganan en los gigs se acumula aquí hasta que lo pagas."
                : "Cash kids earn from gigs accumulates here until you pay it out."}
        </p>

        {kids.length === 0 ? (
            <p class="text-center text-brand-ink-soft py-10">
                {lang === "es" ? "No hay kids todavía." : "No kids yet."}
            </p>
        ) : (
            <div class="space-y-3">
                {kids.map((k) => (
                    <div
                        class="relative bg-brand-cream rounded-2xl p-4 shadow-[var(--shadow-card)] border border-brand-ink/10"
                        data-kid-card
                        data-kid-id={k.user_id}
                    >
                        <div class="flex items-center justify-between gap-3">
                            <div>
                                <h3 class="font-bold text-brand-ink">{k.name}</h3>
                                <p class="text-xs text-brand-ink-soft">
                                    {lang === "es" ? "Ganado" : "Earned"}: {fmt(k.total_earned_cents)}
                                    {" · "}
                                    {lang === "es" ? "Pagado" : "Paid"}: {fmt(k.total_paid_cents)}
                                </p>
                            </div>
                            <div class="text-right">
                                <p class="text-[11px] text-brand-ink-soft uppercase tracking-wider">
                                    {lang === "es" ? "Pendiente" : "Pending"}
                                </p>
                                <p class="text-2xl font-extrabold text-brand-mint-deep" data-balance>
                                    {fmt(k.current_balance_cents)}
                                </p>
                            </div>
                        </div>

                        {(k.recent_gigs ?? []).length > 0 && (
                            <div class="mt-2">
                                <p class="text-[10px] text-brand-ink-soft uppercase tracking-wider mb-1">
                                    {lang === "es" ? "Gigs desde el último pago" : "Gigs since last payout"}
                                </p>
                                <div class="flex flex-wrap gap-1.5">
                                    {k.recent_gigs.map((g: any) => (
                                        <button
                                            type="button"
                                            class="group px-2 py-1 rounded-lg border text-[11px] font-semibold flex items-center gap-1 bg-brand-mint/20 border-brand-mint-deep/40 text-brand-mint-deep focus:outline-none focus:ring-2 focus:ring-brand-mint-deep/50"
                                        >
                                            <span class="max-w-[9rem] truncate">{g.title}</span>
                                            <span class="opacity-70">{fmt(g.amount_cents)}</span>
                                            <span class="hidden group-hover:block group-focus:block pointer-events-none absolute left-2 right-2 top-full mt-1 z-[60] rounded-xl bg-brand-ink text-brand-cream text-left text-xs font-normal p-3 shadow-lg">
                                                <span class="block font-bold mb-0.5">{g.title}</span>
                                                <span class="block">{fmt(g.amount_cents)}</span>
                                                {g.approved_at && (
                                                    <span class="block opacity-80">
                                                        {fmtTzDate(g.approved_at, lang, user.timezone, { weekday: "short", day: "numeric", month: "short" })}
                                                    </span>
                                                )}
                                                {g.approval_notes && (
                                                    <span class="block mt-1 opacity-90">📝 {g.approval_notes}</span>
                                                )}
                                            </span>
                                        </button>
                                    ))}
                                </div>
                            </div>
                        )}

                        <div class="flex items-center gap-2 mt-3">
                            <div class="relative flex-1">
                                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-brand-ink-soft">$</span>
                                <input
                                    type="number"
                                    min="0"
                                    step="0.01"
                                    placeholder={lang === "es" ? "Monto" : "Amount"}
                                    data-amount
                                    class="w-full pl-7 pr-3 py-2 text-sm border border-brand-ink/20 rounded-xl focus:ring-2 focus:ring-emerald-500 outline-none bg-brand-cream"
                                />
                            </div>
                            <button
                                type="button"
                                data-pay
                                class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-sm rounded-xl transition-colors"
                            >
                                {lang === "es" ? "Pagar" : "Pay"}
                            </button>
                            <button
                                type="button"
                                data-pay-all
                                class="px-3 py-2 border-2 border-emerald-600 text-emerald-700 font-semibold text-sm rounded-xl hover:bg-emerald-50 transition-colors"
                            >
                                {lang === "es" ? "Todo" : "All"}
                            </button>
                        </div>
                        <p class="hidden text-xs mt-2" data-msg></p>
                    </div>
                ))}
            </div>
        )}

        {paycheckKids.length > 0 && (
            <>
                <h2 class="text-sm font-bold text-brand-ink pt-2">
                    💵 {lang === "es" ? "Cheques de tareas" : "Chore paychecks"}
                </h2>
                <p class="text-sm text-brand-ink-soft">
                    {lang === "es"
                        ? "Revisa cada semana y libera el pago; al liberarlo se abona al saldo del kid."
                        : "Review each week and release the pay; it credits the kid's balance."}
                </p>
                <div class="space-y-3">
                    {paycheckKids.map((k) => (
                        <div class="rounded-2xl border border-brand-ink/10 bg-brand-cream p-4" data-kid-paycheck-group data-kid-id={k.user_id}>
                            <h3 class="font-bold text-brand-ink mb-2">{k.name}</h3>
                            <div class="space-y-2">
                                {k.outstanding_weeks.map((w: any) => (
                                    <div
                                        class={`relative rounded-xl border-2 p-3 ${w.is_current_week ? "border-brand-mint-deep/40 bg-brand-mint/10" : "border-amber-400/60 bg-amber-50"}`}
                                        data-paycheck-row
                                        data-kid-id={k.user_id}
                                        data-week-of={w.week_of}
                                        data-is-current-week={w.is_current_week ? "1" : "0"}
                                        data-amount-cents={w.amount_cents}
                                    >
                                        <div class="flex items-center justify-between gap-3">
                                            <div>
                                                <p class="text-xs font-bold text-brand-ink flex items-center gap-1.5">
                                                    {!w.is_current_week && (
                                                        <span title={lang === "es" ? "Semana pasada sin liberar" : "Unreleased past week"}>⚠️</span>
                                                    )}
                                                    {dayLabel(w.week_of)}
                                                    {w.is_current_week && (
                                                        <span class="text-[10px] font-semibold text-brand-ink-soft">
                                                            ({lang === "es" ? "en curso" : "in progress"})
                                                        </span>
                                                    )}
                                                </p>
                                                <p class="text-xs text-brand-ink-soft">{w.done_points}/{w.assigned_points} pts · {w.pct}%</p>
                                            </div>
                                            <div class="text-right">
                                                <p class="text-2xl font-extrabold text-brand-mint-deep">{fmt(w.amount_cents)}</p>
                                                <div data-release-slot class="flex flex-col items-end gap-1 mt-1">
                                                    {w.already_released ? (
                                                        <>
                                                            <span class="text-xs font-bold text-brand-mint-deep">
                                                                {lang === "es" ? "Liberado ✓" : "Released ✓"}
                                                            </span>
                                                            {/* A retroactively-approved chore lands on a week that
                                                                may already be paid, and the paycheck is idempotent
                                                                per (kid, week) — so grading credits points but no
                                                                cash. This is the only way to make that up without
                                                                leaving the week's ledger.

                                                                Only the CURRENT week can ever reach this branch:
                                                                list_outstanding_weeks drops released PAST weeks
                                                                (they live in the history). The same control is
                                                                therefore rendered on every history row too — see
                                                                the history panel below — because a past week is
                                                                the common case for a late chore. Markup is
                                                                duplicated there (JSX vs. template string); the
                                                                behaviour is not (wireTopUp). */}
                                                            <div class="flex items-center gap-1.5">
                                                                <label
                                                                    class="text-[11px] text-brand-ink-soft"
                                                                    title={lang === "es"
                                                                        ? "Pago adicional sobre una semana ya liberada — se registra como su propio movimiento"
                                                                        : "Extra payment on an already-released week — recorded as its own ledger entry"}
                                                                >
                                                                    + Extra $
                                                                </label>
                                                                <input type="number" step="1" min="1" max="1000" placeholder="0" data-topup-amount
                                                                    class="w-14 rounded-lg border border-brand-ink/20 bg-white px-1.5 py-1 text-xs text-brand-ink focus:outline-none focus:ring-2 focus:ring-brand-mint-deep" />
                                                                <button type="button" data-topup
                                                                    class="px-2.5 py-1.5 border border-brand-mint-deep text-brand-mint-deep hover:bg-brand-mint/10 font-semibold text-xs rounded-lg transition-colors">
                                                                    {lang === "es" ? "Pagar" : "Pay"}
                                                                </button>
                                                            </div>
                                                        </>
                                                    ) : (
                                                        <>
                                                            <div class="flex items-center gap-1.5">
                                                                <label
                                                                    class="text-[11px] text-brand-ink-soft"
                                                                    title={lang === "es"
                                                                        ? "Bono o descuento EXTRA sobre el monto de arriba — no escribas aquí el total a pagar"
                                                                        : "Extra bonus or dock ON TOP of the amount above — don't type the total to pay here"}
                                                                >
                                                                    {lang === "es" ? "+ Ajuste $" : "+ Adj $"}
                                                                </label>
                                                                <input type="number" step="1" placeholder="0" data-adjust
                                                                    class="w-14 rounded-lg border border-brand-ink/20 bg-white px-1.5 py-1 text-xs text-brand-ink focus:outline-none focus:ring-2 focus:ring-brand-mint-deep" />
                                                                <button type="button" data-release
                                                                    class="px-3 py-1.5 bg-brand-mint-deep hover:opacity-90 text-white font-semibold text-xs rounded-lg transition-opacity">
                                                                    {lang === "es" ? "Liberar" : "Release"}
                                                                </button>
                                                            </div>
                                                            <p class="text-[11px] text-brand-ink-soft">
                                                                {lang === "es" ? "Total a liberar: " : "Total to release: "}
                                                                <span class="font-bold text-brand-ink" data-total-value>{fmt(w.amount_cents)}</span>
                                                            </p>
                                                        </>
                                                    )}
                                                </div>
                                            </div>
                                        </div>
                                        {(w.tasks ?? []).length > 0 && (
                                            <div class="flex flex-wrap gap-1.5 mt-3">
                                                {w.tasks.map((t: any) => (
                                                    <button
                                                        type="button"
                                                        class={`group px-2 py-1 rounded-lg border text-[11px] font-semibold flex items-center gap-1 focus:outline-none focus:ring-2 focus:ring-brand-mint-deep/50 ${chipCls[t.status] ?? chipCls.not_done}`}
                                                    >
                                                        <span aria-hidden="true">{chipIcon[t.status] ?? "·"}</span>
                                                        <span class="max-w-[9rem] truncate">{t.title}</span>
                                                        <span class="opacity-70">{t.earned_points}/{t.points}</span>
                                                        <span class="hidden group-hover:block group-focus:block pointer-events-none absolute left-2 right-2 bottom-full mb-1 z-[60] rounded-xl bg-brand-ink text-brand-cream text-left text-xs font-normal p-3 shadow-lg">
                                                            <span class="block font-bold mb-0.5">{t.title}</span>
                                                            <span class="block">{statusLabel(t)} · {t.earned_points}/{t.points} pts</span>
                                                            <span class="block opacity-80">{dayLabel(t.assigned_date)}</span>
                                                            {t.approval_notes && (
                                                                <span class="block mt-1 opacity-90">📝 {t.approval_notes}</span>
                                                            )}
                                                        </span>
                                                    </button>
                                                ))}
                                            </div>
                                        )}
                                        <p class="hidden text-xs mt-2" data-msg></p>
                                    </div>
                                ))}
                            </div>
                            <button
                                type="button"
                                data-history-toggle
                                data-kid-id={k.user_id}
                                class="mt-3 text-xs font-semibold text-brand-mint-deep underline underline-offset-2"
                            >
                                {lang === "es" ? "Ver historial" : "View history"}
                            </button>
                            <div class="hidden mt-2 space-y-2" data-history-panel data-kid-id={k.user_id}></div>
                        </div>
                    ))}
                </div>
            </>
        )}
    </div>
</PageLayout>

<script>
import { normalizeErrorDetail } from "../../lib/errors";

(function initPayouts() {
    // Read from the cookie rather than define:vars: an inline script cannot
    // import, and this page needs normalizeErrorDetail (same pattern as
    // parent/gigs.astro).
    const lang = document.cookie.split(";").find((c) => c.trim().startsWith("lang="))?.split("=")[1] ?? "es";
    const fmt = (cents: number) => `$${(cents / 100).toFixed(2)}`;

    // ChorePaycheckReleaseBody caps adjustment_cents at 100000, and this input
    // is typed in pesos (×100). Checked in JS as well as via the input's `max`
    // because nothing here submits a <form>, so the browser never runs
    // constraint validation on its own.
    const MAX_TOPUP_CENTS = 100000;

    /** The backend's `detail` is a string, an array of Pydantic errors, or a
     * structured object depending on which guard fired — concatenating it
     * blind prints "[object Object]" (reachable: an over-cap adjustment_cents
     * comes back as the array shape). normalizeErrorDetail is the one place
     * that knows all three. The `message` fallback is for the fourth shape it
     * cannot help with: this app's own exception handlers answer
     * {error, message, status_code} with no `detail` key at all, which is what
     * a wrong/foreign kid id on these routes comes back as. */
    const errorText = (data: any, status: number): string =>
        normalizeErrorDetail(data?.detail, lang)
        ?? (typeof data?.message === "string" ? data.message : null)
        ?? `Error ${status}`;

    // Live totals header. Releasing a paycheck moves money between buckets
    // (paycheck → gig cash, kid balance credited) so the grand total holds;
    // recording a payout shrinks cash and the grand total.
    const header = document.querySelector<HTMLElement>("[data-owed-header]");
    function adjustTotals(cashDelta: number, paycheckDelta: number) {
        if (!header) return;
        const cash = Math.max(0, parseInt(header.dataset.cashCents || "0", 10) + cashDelta);
        const paycheck = Math.max(0, parseInt(header.dataset.paycheckCents || "0", 10) + paycheckDelta);
        header.dataset.cashCents = String(cash);
        header.dataset.paycheckCents = String(paycheck);
        header.querySelector("[data-cash-total]")!.textContent = fmt(cash);
        header.querySelector("[data-paycheck-total]")!.textContent = fmt(paycheck);
        header.querySelector("[data-grand-total]")!.textContent = fmt(cash + paycheck);
    }

    document.querySelectorAll("[data-kid-card]").forEach((card) => {
        const kidId = card.getAttribute("data-kid-id");
        const amountEl = card.querySelector<HTMLInputElement>("[data-amount]")!;
        const balanceEl = card.querySelector<HTMLElement>("[data-balance]")!;
        const msgEl = card.querySelector<HTMLElement>("[data-msg]")!;
        const payBtn = card.querySelector<HTMLButtonElement>("[data-pay]")!;
        const payAllBtn = card.querySelector<HTMLButtonElement>("[data-pay-all]")!;

        function currentBalanceCents() {
            const txt = (balanceEl.textContent || "").replace(/[^0-9.]/g, "");
            return Math.round(parseFloat(txt || "0") * 100);
        }

        function showMsg(text: string, ok: boolean) {
            msgEl.textContent = text;
            msgEl.classList.remove("hidden", "text-red-600", "text-emerald-700");
            msgEl.classList.add(ok ? "text-emerald-700" : "text-red-600");
        }

        async function pay(amountCents: number) {
            if (!amountCents || amountCents <= 0) {
                showMsg(lang === "es" ? "Ingresa un monto" : "Enter an amount", false);
                return;
            }
            payBtn.disabled = true;
            payAllBtn.disabled = true;
            try {
                const res = await fetch(`/api/cash/${kidId}/payout`, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ amount_cents: amountCents }),
                });
                const data = await res.json().catch(() => ({}));
                if (!res.ok) {
                    showMsg(errorText(data, res.status), false);
                    return;
                }
                balanceEl.textContent = fmt(data.new_balance_cents);
                amountEl.value = "";
                adjustTotals(-amountCents, 0);
                showMsg(
                    (lang === "es" ? "Pagado. Nuevo saldo: " : "Paid. New balance: ") + fmt(data.new_balance_cents),
                    true
                );
            } catch (e) {
                showMsg(lang === "es" ? "Error de red" : "Network error", false);
            } finally {
                payBtn.disabled = false;
                payAllBtn.disabled = false;
            }
        }

        payBtn.addEventListener("click", () => {
            const pesos = parseFloat(amountEl.value || "0");
            pay(Math.round(pesos * 100));
        });
        payAllBtn.addEventListener("click", () => pay(currentBalanceCents()));
    });

    // ── Top up an ALREADY-RELEASED week ──────────────────────────────────
    /**
     * Wire one "+ Extra $" control. Called for BOTH places a released week is
     * visible, which is the whole point of it being a function:
     *
     *  - the outstanding list, where only the CURRENT week can be released
     *    (list_outstanding_weeks skips released past weeks by design), and
     *  - every row of the history panel, which is where a released PAST week
     *    actually lives — and a chore marked done for a kid reaches back 7
     *    weeks, so "the week was already paid" is normally a past week.
     *
     * Wiring only the first left the control missing for the dominant case.
     */
    function wireTopUp(row: Element, kidId: string | null, weekOf: string | null) {
        const topBtn = row.querySelector<HTMLButtonElement>("[data-topup]");
        if (!topBtn || !kidId || !weekOf) return;
        const amountEl = row.querySelector<HTMLInputElement>("[data-topup-amount]");
        const msgEl = row.querySelector<HTMLElement>("[data-msg]");

        const say = (text: string, isError: boolean) => {
            if (!msgEl) return;
            msgEl.textContent = text;
            msgEl.classList.remove("hidden");
            msgEl.classList.toggle("text-red-600", Boolean(isError));
        };

        topBtn.addEventListener("click", async () => {
            const cents = Math.round((parseFloat(amountEl?.value || "0") || 0) * 100);
            // The API rejects a non-positive top-up; say so here rather than
            // spending a round trip to be told.
            if (cents <= 0) {
                say(lang === "es"
                    ? "Escribe un monto mayor a 0."
                    : "Enter an amount greater than 0.", true);
                return;
            }
            if (cents > MAX_TOPUP_CENTS) {
                say(lang === "es"
                    ? `El máximo por pago extra es ${fmt(MAX_TOPUP_CENTS)}.`
                    : `The most one extra payment can be is ${fmt(MAX_TOPUP_CENTS)}.`, true);
                return;
            }
            const original = topBtn.textContent;
            topBtn.disabled = true;
            topBtn.textContent = "…";
            try {
                const res = await fetch(`/api/bank/chore-paycheck/${kidId}/release`, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        week_of: weekOf,
                        adjustment_cents: cents,
                        top_up: true,
                    }),
                });
                const data = await res.json().catch(() => ({}));
                if (!res.ok) {
                    say(errorText(data, res.status), true);
                    topBtn.disabled = false;
                    topBtn.textContent = original;
                    return;
                }
                say(lang === "es"
                    ? `Pago extra de ${fmt(cents)} registrado.`
                    : `Extra payment of ${fmt(cents)} recorded.`, false);
                // Reload so the balance and the week's history reflect it.
                setTimeout(() => window.location.reload(), 900);
            } catch {
                say(lang === "es" ? "Error de red." : "Network error.", true);
                topBtn.disabled = false;
                topBtn.textContent = original;
            }
        });
    }

    // The outstanding rows. Separate pass from the release loop below, which
    // bails when there is no [data-release] button — which is exactly every
    // released row.
    document.querySelectorAll("[data-paycheck-row]").forEach((row) => {
        wireTopUp(row, row.getAttribute("data-kid-id"), row.getAttribute("data-week-of"));
    });

    // ── Release a specific outstanding week's chore paycheck ─────────────
    document.querySelectorAll("[data-paycheck-row]").forEach((row) => {
        const btn = row.querySelector<HTMLButtonElement>("[data-release]");
        if (!btn) return;
        const weekOf = row.getAttribute("data-week-of");
        const isCurrentWeek = row.getAttribute("data-is-current-week") === "1";
        const projected = parseInt(row.getAttribute("data-amount-cents") || "0", 10);
        const kidId = row.getAttribute("data-kid-id");
        const adjustEl = row.querySelector<HTMLInputElement>("[data-adjust]");
        const totalValueEl = row.querySelector<HTMLElement>("[data-total-value]");
        const msgEl = row.querySelector<HTMLElement>("[data-msg]")!;
        const slot = row.querySelector<HTMLElement>("[data-release-slot]")!;

        const updateTotalPreview = () => {
            if (!totalValueEl) return;
            const adj = Math.round((parseFloat(adjustEl?.value || "0") || 0) * 100);
            totalValueEl.textContent = fmt(Math.max(0, projected + adj));
        };
        adjustEl?.addEventListener("input", updateTotalPreview);

        btn.addEventListener("click", async () => {
            const adjustCents = Math.round((parseFloat(adjustEl?.value || "0") || 0) * 100);
            btn.disabled = true;
            try {
                const res = await fetch(`/api/bank/chore-paycheck/${kidId}/release`, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ week_of: weekOf, adjustment_cents: adjustCents }),
                });
                const data = await res.json().catch(() => ({}));
                if (!res.ok) {
                    msgEl.textContent = errorText(data, res.status);
                    msgEl.classList.remove("hidden");
                    msgEl.classList.add("text-red-600");
                    btn.disabled = false;
                    return;
                }
                const amt = data.amount_cents || 0;
                if (isCurrentWeek) {
                    // Matches prior UX: the current week's row stays visible
                    // for the rest of the week, just flips to "Released".
                    slot.innerHTML = `<span class="text-xs font-bold text-brand-mint-deep">${
                        lang === "es" ? "Liberado ✓" : "Released ✓"
                    }</span>`;
                } else {
                    // A past week is now historical — drop the row.
                    row.remove();
                }
                adjustTotals(amt, -projected);
                const bal = document.querySelector(
                    `[data-kid-card][data-kid-id="${kidId}"] [data-balance]`
                );
                if (bal) {
                    const cur = Math.round(parseFloat((bal.textContent || "").replace(/[^0-9.]/g, "") || "0") * 100);
                    bal.textContent = fmt(cur + amt);
                }
            } catch (e) {
                msgEl.textContent = lang === "es" ? "Error de red" : "Network error";
                msgEl.classList.remove("hidden");
                msgEl.classList.add("text-red-600");
                btn.disabled = false;
            }
        });
    });

    // ── Chore-paycheck history (lazy-fetched on first expand, per kid) ───
    const histChipCls: Record<string, string> = {
        credited: "bg-brand-mint/20 border-brand-mint-deep/40 text-brand-mint-deep",
        pending_review: "bg-amber-100 border-amber-300 text-amber-800",
        missed: "bg-red-100 border-red-300 text-red-700",
        not_done: "bg-brand-ink/5 border-brand-ink/15 text-brand-ink-soft",
    };
    const histChipIcon: Record<string, string> = { credited: "✓", pending_review: "⏳", missed: "✗", not_done: "·" };

    function histStatusLabel(t: any) {
        if (t.status === "credited") {
            const base = lang === "es" ? "Completada ✓" : "Completed ✓";
            return t.grade === "partial"
                ? `${base} · ${lang === "es" ? "parcial" : "partial"} ${t.partial_credit_pct}%`
                : base;
        }
        if (t.status === "pending_review") return lang === "es" ? "Esperando revisión" : "Awaiting review";
        if (t.status === "missed") return lang === "es" ? "No cumplida" : "Missed";
        return lang === "es" ? "Sin hacer" : "Not done yet";
    }

    function histDayLabel(iso: string) {
        return new Date(`${iso}T00:00:00`).toLocaleDateString(lang === "es" ? "es-MX" : "en-US", {
            weekday: "short", day: "numeric", month: "short",
        });
    }

    function escapeHtml(s: unknown) {
        return String(s).replace(/[&<>"']/g, (c) => (
            ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" } as Record<string, string>)[c]
        ));
    }

    /** The "+ Extra $" control for a history row. Every history week is by
     * definition already released — it IS a ledger row — so unlike the
     * outstanding list there is no released/unreleased branch here. Mirrors
     * the JSX version above; the behaviour behind it is the shared wireTopUp,
     * which reads the week off the row's data-week-of. */
    function renderTopUp() {
        const title = lang === "es"
            ? "Pago adicional sobre una semana ya liberada — se registra como su propio movimiento"
            : "Extra payment on an already-released week — recorded as its own ledger entry";
        const pay = lang === "es" ? "Pagar" : "Pay";
        return `
            <div class="flex items-center justify-end gap-1.5 mt-2">
                <label class="text-[11px] text-brand-ink-soft" title="${escapeHtml(title)}">+ Extra $</label>
                <input type="number" step="1" min="1" max="1000" placeholder="0" data-topup-amount
                    class="w-14 rounded-lg border border-brand-ink/20 bg-brand-cream px-1.5 py-1 text-xs text-brand-ink focus:outline-none focus:ring-2 focus:ring-brand-mint-deep" />
                <button type="button" data-topup
                    class="px-2.5 py-1.5 border border-brand-mint-deep text-brand-mint-deep hover:bg-brand-mint/10 font-semibold text-xs rounded-lg transition-colors">${pay}</button>
            </div>
            <p class="hidden text-xs mt-2" data-msg></p>
        `;
    }

    function renderWeekTasks(tasks: any[]) {
        return (tasks || []).map((t: any) => `
            <button type="button" class="group px-2 py-1 rounded-lg border text-[11px] font-semibold flex items-center gap-1 focus:outline-none focus:ring-2 focus:ring-brand-mint-deep/50 ${histChipCls[t.status] || histChipCls.not_done}">
                <span aria-hidden="true">${histChipIcon[t.status] || "·"}</span>
                <span class="max-w-[9rem] truncate">${escapeHtml(t.title)}</span>
                <span class="opacity-70">${t.earned_points}/${t.points}</span>
                <span class="hidden group-hover:block group-focus:block pointer-events-none absolute left-2 right-2 bottom-full mb-1 z-[60] rounded-xl bg-brand-ink text-brand-cream text-left text-xs font-normal p-3 shadow-lg">
                    <span class="block font-bold mb-0.5">${escapeHtml(t.title)}</span>
                    <span class="block">${histStatusLabel(t)} · ${t.earned_points}/${t.points} pts</span>
                    <span class="block opacity-80">${histDayLabel(t.assigned_date)}</span>
                    ${t.approval_notes ? `<span class="block mt-1 opacity-90">📝 ${escapeHtml(t.approval_notes)}</span>` : ""}
                </span>
            </button>
        `).join("");
    }

    document.querySelectorAll("[data-history-toggle]").forEach((btn) => {
        const kidId = btn.getAttribute("data-kid-id");
        const panel = document.querySelector<HTMLElement>(`[data-history-panel][data-kid-id="${kidId}"]`);
        if (!panel) return;
        let loaded = false;

        btn.addEventListener("click", async () => {
            const opening = panel.classList.contains("hidden");
            if (!opening) {
                panel.classList.add("hidden");
                btn.textContent = lang === "es" ? "Ver historial" : "View history";
                return;
            }
            panel.classList.remove("hidden");
            btn.textContent = lang === "es" ? "Ocultar historial" : "Hide history";
            if (loaded) return;
            loaded = true;

            panel.innerHTML = `<p class="text-xs text-brand-ink-soft">${lang === "es" ? "Cargando…" : "Loading…"}</p>`;
            try {
                const res = await fetch(`/api/bank/chore-paycheck/${kidId}/history`);
                const data = await res.json().catch(() => ({}));
                if (!res.ok) {
                    panel.innerHTML = `<p class="text-xs text-red-600">${escapeHtml(errorText(data, res.status))}</p>`;
                    return;
                }
                const weeks = data.weeks || [];
                if (weeks.length === 0) {
                    panel.innerHTML = `<p class="text-xs text-brand-ink-soft">${
                        lang === "es" ? "Sin historial todavía." : "No history yet."
                    }</p>`;
                    return;
                }
                panel.innerHTML = weeks.map((w: any) => `
                    <div class="relative rounded-xl border border-brand-ink/10 bg-white p-3"
                         data-history-week data-week-of="${escapeHtml(w.week_of)}">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-bold text-brand-ink">${histDayLabel(w.week_of)}</span>
                            <span class="text-sm font-extrabold text-brand-mint-deep">${fmt(w.amount_cents)}</span>
                        </div>
                        <div class="flex flex-wrap gap-1.5 mt-2">${renderWeekTasks(w.tasks)}</div>
                        ${renderTopUp()}
                    </div>
                `).join("") + (data.has_more ? `<p class="text-[11px] text-brand-ink-soft">${
                    lang === "es" ? "Mostrando las últimas 12 semanas." : "Showing the last 12 weeks."
                }</p>` : "");
                // Same handler the outstanding rows get. This is the branch
                // that matters: a released PAST week only ever appears here.
                panel.querySelectorAll("[data-history-week]").forEach((histRow) => {
                    wireTopUp(histRow, kidId, histRow.getAttribute("data-week-of"));
                });
            } catch (e) {
                panel.innerHTML = `<p class="text-xs text-red-600">${
                    lang === "es" ? "Error de red" : "Network error"
                }</p>`;
            }
        });
    });
})();
</script>
