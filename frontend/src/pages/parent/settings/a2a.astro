---
import Layout from "@layouts/Layout.astro";
import BottomNav from "@components/BottomNav.astro";
import DrawerMenu from "@components/DrawerMenu.astro";
import UpgradePrompt from "@components/UpgradePrompt.astro";
import { apiFetch } from "@lib/api";
import { isFreePlan } from "@lib/plan";

const token = Astro.cookies.get("access_token")?.value;
if (!token) return Astro.redirect("/login");
const lang = (Astro.cookies.get("lang")?.value ?? "es") as "en" | "es";
const { data: user } = await apiFetch<any>("/api/auth/me", { token });
if (user?.role !== "parent") return Astro.redirect("/dashboard");

// A2A webhook config is a Plus+ feature (a2a_webhook). Fail-open plan
// check; the backend PUT enforces require_feature regardless.
const a2aLocked = await isFreePlan(token);
const { data: cfg } = a2aLocked
    ? { data: null as any }
    : await apiFetch<any>("/api/budget/a2a-webhook", { token });
---

<Layout title={lang === "es" ? "Agente de precios" : "Price Agent"} lang={lang}>
  <DrawerMenu lang={lang} />
  <main class="px-4 pb-32 pt-6 max-w-md mx-auto">
    <h1 class="text-2xl font-display mb-4">{lang === "es" ? "Agente de precios" : "Price Agent"}</h1>

    {a2aLocked ? (
      <UpgradePrompt feature="a2a_webhook" planNeeded="Plus" lang={lang} />
    ) : (
    <form id="form" class="card p-4 space-y-3">
      <label class="block">
        <span class="text-sm">URL</span>
        <input id="url" type="url" required pattern="https://.*"
               value={cfg?.url ?? ""} class="brand-input w-full" />
      </label>
      <label class="flex items-center gap-2">
        <input id="enabled" type="checkbox" checked={cfg?.enabled} />
        <span>{lang === "es" ? "Activo" : "Enabled"}</span>
      </label>
      <label class="flex items-center gap-2">
        <input id="rotate" type="checkbox" />
        <span>{lang === "es" ? "Rotar secreto" : "Rotate secret"}</span>
      </label>
      <div class="text-xs text-fg/60">
        {lang === "es" ? "Último éxito" : "Last success"}: {cfg?.last_success_at ?? "—"}<br/>
        {lang === "es" ? "Fallas" : "Failures"}: {cfg?.failure_count ?? 0}
      </div>
      <button id="a2a-save" type="submit" class="brand-btn brand-btn-primary w-full">
        {lang === "es" ? "Guardar" : "Save"}
      </button>
      <pre id="secret-out" class="hidden text-xs bg-fg/5 p-2 rounded"></pre>
    </form>
    )}
  </main>
  <BottomNav lang={lang} role={user?.role} active="parent" />
</Layout>

<script>
  const es = document.documentElement.lang === "es";
  const form = document.getElementById("form") as HTMLFormElement | null;
  const saveBtn = document.getElementById("a2a-save") as HTMLButtonElement | null;
  const rotate = document.getElementById("rotate") as HTMLInputElement | null;

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    // Every save with "rotate secret" ticked mints a NEW secret and only the
    // response carries it — a second in-flight request would strand the user
    // with a secret they never saw. Hence the disable, and the untick below.
    if (saveBtn?.disabled) return;
    const label = saveBtn?.textContent ?? "";
    if (saveBtn) { saveBtn.disabled = true; saveBtn.textContent = "…"; }
    try {
      const resp = await fetch("/api/budget/a2a-webhook", {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          url: (document.getElementById("url") as HTMLInputElement).value,
          enabled: (document.getElementById("enabled") as HTMLInputElement).checked,
          rotate_secret: !!rotate?.checked,
        }),
      });
      const body = await resp.json().catch(() => null);
      if (!resp.ok) {
        const detail = body?.detail;
        const msg = detail?.error === "upgrade_required"
          ? (es ? "Requiere plan Plus — ve a Suscripción." : "Requires the Plus plan — see Subscription.")
          : (typeof detail === "string" ? detail : (es ? "Error al guardar." : "Save failed."));
        alert(msg);
        return;
      }
      if (body?.secret) {
        const out = document.getElementById("secret-out")!;
        out.classList.remove("hidden");
        out.textContent = (es ? "Secreto nuevo (cópialo): " : "New secret (copy now): ") + body.secret;
        if (rotate) rotate.checked = false;
      } else {
        alert(es ? "Guardado." : "Saved.");
      }
    } catch {
      alert(es ? "Error de conexión. Intenta de nuevo." : "Connection error. Please try again.");
    } finally {
      if (saveBtn) { saveBtn.disabled = false; saveBtn.textContent = label; }
    }
  });
</script>
