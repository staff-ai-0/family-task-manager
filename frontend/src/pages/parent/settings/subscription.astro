---
import PageLayout from "@components/ui/PageLayout.astro";
import { apiFetch } from "../../../lib/api";
import { fmtDate } from "../../../lib/datetime";

const token = Astro.cookies.get("access_token")?.value;
if (!token) return Astro.redirect("/login");
const lang = (Astro.cookies.get("lang")?.value ?? "es") as "en" | "es";

const { data: user } = await apiFetch<any>("/api/auth/me", { token });
if (!user) {
    Astro.cookies.delete("access_token", { path: "/" });
    return Astro.redirect("/login");
}
if (user.role !== "parent") return Astro.redirect("/dashboard");

// Fetch subscription data in parallel. Plans are fetched WITHOUT a currency
// filter so we can tell which currencies are actually checkout-able (wired
// to PayPal) before choosing a default or rendering the toggle.
const [plansRes, currentRes, usageRes, creditsRes] = await Promise.all([
    apiFetch<any[]>("/api/subscriptions/plans", { token }),
    apiFetch<any>("/api/subscriptions/current", { token }),
    apiFetch<any>("/api/subscriptions/usage", { token }),
    apiFetch<any[]>("/api/subscriptions/credits", { token }),
]);

const plans = plansRes.data ?? [];
const current = currentRes.data;
const usage = usageRes.data;
const credits = creditsRes.data ?? [];

// A currency is checkout-READY when it offers paid rows and every one of
// them is wired to a PayPal plan (checkout_ready_monthly — the upgrade
// buttons checkout monthly). Migration-seeded MXN rows start inactive (never
// listed) until the operator wires them; this additionally guards rows that
// are active but not (yet fully) wired.
const PAID_TIERS = ["plus", "pro"];
const paidPlans = plans.filter((p: any) => PAID_TIERS.includes(p.name));
const rowCurrency = (p: any) => p.currency ?? "USD";
const offeredCurrencies = [...new Set(paidPlans.map(rowCurrency))];
const isCurrencyReady = (cur: string) => {
    const rows = paidPlans.filter((p: any) => rowCurrency(p) === cur);
    // Missing checkout_ready_* (older backend) → assume ready (legacy behavior).
    return rows.length > 0 && rows.every((p: any) => p.checkout_ready_monthly !== false);
};
const readyCurrencies = ["MXN", "USD"].filter(
    (c) => offeredCurrencies.includes(c) && isCurrencyReady(c),
);

// Currency selection — Mexico-first (MXN default) among READY currencies, so
// users are never defaulted onto prices they cannot check out. An explicit
// ?currency= is still honored; its upgrade buttons disable below if unwired.
const requestedCurrency = Astro.url.searchParams.get("currency")?.toUpperCase();
const validRequested =
    requestedCurrency === "USD" || requestedCurrency === "MXN" ? requestedCurrency : null;
const defaultCurrency =
    readyCurrencies[0] ??
    (offeredCurrencies.includes("MXN") ? "MXN" : offeredCurrencies[0] ?? "MXN");
const selectedCurrency = validRequested ?? defaultCurrency;

// Toggle pills: only checkout-ready currencies (plus the selected one so the
// active pill always renders). A single option needs no toggle at all —
// nobody should be able to switch onto un-checkout-able prices.
const toggleCurrencies = ["MXN", "USD"].filter(
    (c) => readyCurrencies.includes(c) || c === selectedCurrency,
);
const showCurrencyToggle = toggleCurrencies.length >= 2;
// Post-checkout outcome banners. ?upgraded=1 comes from the PayPal return
// redirect (activate.astro), ?cancelled=1 from the PayPal cancel URL.
const justUpgraded = Astro.url.searchParams.get("upgraded") === "1";
const checkoutCancelled = Astro.url.searchParams.get("cancelled") === "1";

// Preserve unrelated query params (e.g. ?cancelled=1 from a PayPal cancel
// return) — only the currency key is replaced.
const currencyHref = (cur: string) => {
    const params = new URLSearchParams(Astro.url.searchParams);
    params.set("currency", cur);
    return `?${params.toString()}`;
};

// Resolve the paid tiers' price rows for the selected currency.
const planForTier = (name: string) =>
    plans.find((p: any) => p.name === name && rowCurrency(p) === selectedCurrency) ??
    plans.find((p: any) => p.name === name);
const plusPlan = planForTier("plus");
const proPlan = planForTier("pro");

// A tier is upgradeable only when its row matches the selected currency AND
// is wired to PayPal AND is actually priced — otherwise checkout would
// 404/501, or worse, create a PayPal subscription at a price we never showed.
const canCheckout = (plan: any) =>
    Boolean(
        plan &&
        rowCurrency(plan) === selectedCurrency &&
        plan.checkout_ready_monthly !== false &&
        // A paid tier priced 0 is misconfiguration; selling it would create
        // a PayPal subscription whose price does not match what we showed.
        (plan.price_monthly_cents ?? 0) > 0,
    );

// No price constants live here. A missing plan row renders "—" and disables
// checkout rather than printing a price the backend never confirmed — which
// is exactly how this page advertised "$0/mes" for two weeks in July 2026
// (the rows existed with a real 0, so the old `?? fallbackCents[...]` never
// fired). Canonical prices: backend/app/core/plan_pricing.py.

// 'MX$99' / 'US$5' style — Intl.NumberFormat es-MX renders both MXN and USD
// as a bare '$', so prefix the country code to disambiguate the two pesos.
function formatPrice(cents: number, currency: string): string {
    const amount = cents / 100;
    let s = new Intl.NumberFormat(lang === "es" ? "es-MX" : "en-US", {
        style: "currency",
        currency,
        currencyDisplay: "narrowSymbol",
        minimumFractionDigits: 0,
        maximumFractionDigits: Number.isInteger(amount) ? 0 : 2,
    }).format(amount);
    if (currency === "MXN" && !s.includes("MX")) s = `MX${s}`;
    if (currency === "USD" && !s.includes("US")) s = `US${s}`;
    return s;
}

// Returns null when the tier has no row in the selected currency, or when
// the row is priced 0 (a paid tier at 0 is a backend misconfiguration, not
// a free plan — see GET /api/admin/billing-config).
const price = (plan: any, cycle: "monthly" | "annual"): string | null => {
    const cents = plan?.[`price_${cycle}_cents`];
    if (typeof cents !== "number" || cents <= 0) return null;
    return formatPrice(cents, plan?.currency ?? selectedCurrency);
};

const currentPlanName = (current?.plan?.name ?? current?.plan_name ?? "free").toLowerCase();
// Plan credits floor the DISPLAYED tier: grants never write FamilySubscription
// rows, so /current reports "free" for a credit-only family while the banner
// says "PRO free until …". A credit only ever raises the shown tier — a real
// paid sub of equal/higher tier wins unchanged — and isPaid/cancel stay keyed
// to the REAL subscription (a credit has no PayPal sub to cancel).
// /credits returns QUEUED grants too (a second code of the same tier starts
// when the first ends), so the floor must use only the ones already running —
// a queued Pro credit must not show the family as Pro before its window opens.
const nowMs = Date.now();
const isLive = (c: any) => !c.starts_at || Date.parse(c.starts_at) <= nowMs;
const TIER_RANK: Record<string, number> = { free: 0, plus: 1, pro: 2 };
const creditTier = credits.filter(isLive).reduce(
    (best: string, c: any) =>
        (TIER_RANK[c.tier] ?? 0) > (TIER_RANK[best] ?? 0) ? c.tier : best,
    "free",
);
const effectivePlanName =
    (TIER_RANK[creditTier] ?? 0) > (TIER_RANK[currentPlanName] ?? 0)
        ? creditTier
        : currentPlanName;
const isActive = current?.status === "active";
const isCancelled = current?.status === "cancelled";
const isPaid = currentPlanName !== "free";
// The upgrade buttons key off the REAL paid tier, NOT the credit-floored
// display tier. A family holding a 30-day Pro coupon — the exact launch flow
// this page exists to serve — renders effectivePlanName === "pro", which hid
// BOTH buttons; and isPaid is still false, so there was no cancel/manage
// block either. The highest-intent moment in the funnel offered them nothing
// to buy, even though POST /subscriptions/checkout has no tier guard and the
// purchase works fine. The floor still drives the header and the comparison
// highlight — that part was the point.
const liveCredits = credits.filter(isLive);
const isCreditFloored = effectivePlanName !== currentPlanName;
const hasLifetimeCredit = liveCredits.some((c: any) => c.lifetime || !c.ends_at);
const creditEndsIso = hasLifetimeCredit
    ? null
    : liveCredits.reduce(
          (latest: string | null, c: any) =>
              !latest || Date.parse(c.ends_at) > Date.parse(latest)
                  ? c.ends_at
                  : latest,
          null,
      );
// True when at least one rendered upgrade button is disabled because the
// selected currency's row is not checkout-able — shows the explainer note.
// Keyed to the same tier as the buttons it describes.
const upgradeUnavailable =
    (currentPlanName === "free" && !canCheckout(plusPlan)) ||
    (currentPlanName !== "pro" && !canCheckout(proPlan));
const cancelAtPeriodEnd = Boolean(current?.cancel_at_period_end);
const periodEndIso = current?.current_period_end ?? null;
const periodEndLabel = periodEndIso
    ? fmtDate(periodEndIso, lang, user.timezone, {
        year: "numeric",
        month: "long",
        day: "numeric",
    })
    : "";

const i18n = {
    en: {
        title: "Subscription",
        back: "Settings",
        upgraded_banner: "Your subscription is active. Welcome aboard!",
        cancelled_banner: "Checkout cancelled — you were not charged.",
        checkout_error: "Upgrade failed",
        current_plan: "Current Plan",
        active: "Active",
        cancelled: "Cancelled",
        cancel_scheduled: "Cancellation scheduled",
        access_until: "You keep your current plan benefits until",
        usage_title: "Current Usage",
        of: "of",
        unlimited: "Unlimited",
        this_month: "this month",
        plan_comparison: "Plan Comparison",
        one_membership: "One membership, the whole family",
        currency_toggle: "Currency",
        feature: "Feature",
        free: "Free",
        plus: "Plus",
        pro: "Pro",
        month: "/mo",
        year: "/yr",
        upgrade: "Upgrade",
        coming_soon: "Upgrades in this currency are coming soon — checkout is not available yet.",
        cancel: "Cancel Subscription",
        cancel_confirm: "Are you sure you want to cancel your subscription?",
        support_prompt: "Questions about your plan or billing? Email us at",
        credit_banner_until: "free until",
        credit_banner_starts: "starts",
        credit_banner_lifetime: "for life",
        credit_source_coupon: "coupon",
        credit_source_referral: "referral",
        credit_source_operator: "courtesy",
        credit_upgrade_note:
            "Your {tier} credit is free until {date}. Buying a plan now is not " +
            "wasted — paid time is added on top, starting when the credit ends.",
        credit_upgrade_lifetime:
            "Your {tier} credit never expires, so there is nothing you need to buy.",
        coupon_title: "Have a coupon?",
        coupon_placeholder: "CODE",
        coupon_apply: "Apply",
        coupon_invalid: "That code is not valid or has expired.",
        coupon_already: "You already used this code.",
        coupon_error: "Could not apply the code. Try again.",
        features: {
            tasks_rewards: "Tasks & Rewards",
            family_members: "Family Members",
            budget_accounts: "Budget Accounts",
            transactions_month: "Transactions / month",
            reports_goals: "Reports & Goals",
            recurring_transactions: "Recurring Transactions",
            csv_import: "CSV Import",
            ai_receipt_scan: "AI Receipt Scanning",
            future_ai: "Future AI Features",
        },
    },
    es: {
        title: "Suscripci\u00f3n",
        back: "Configuraci\u00f3n",
        upgraded_banner: "Tu suscripci\u00f3n est\u00e1 activa. \u00a1Bienvenido!",
        cancelled_banner: "Pago cancelado \u2014 no se hizo ning\u00fan cargo.",
        checkout_error: "No se pudo completar la mejora",
        current_plan: "Plan Actual",
        active: "Activo",
        cancelled: "Cancelado",
        cancel_scheduled: "Cancelación programada",
        access_until: "Conservas los beneficios del plan actual hasta",
        usage_title: "Uso Actual",
        of: "de",
        unlimited: "Ilimitado",
        this_month: "este mes",
        plan_comparison: "Comparaci\u00f3n de Planes",
        one_membership: "Una membres\u00eda, toda la familia",
        currency_toggle: "Moneda",
        feature: "Caracter\u00edstica",
        free: "Gratis",
        plus: "Plus",
        pro: "Pro",
        month: "/mes",
        year: "/a\u00f1o",
        upgrade: "Mejorar Plan",
        coming_soon: "Muy pronto podr\u00e1s mejorar tu plan en esta moneda \u2014 el pago a\u00fan no est\u00e1 disponible.",
        cancel: "Cancelar Suscripci\u00f3n",
        cancel_confirm: "\u00bfEst\u00e1s seguro de que quieres cancelar tu suscripci\u00f3n?",
        support_prompt: "\u00bfDudas sobre tu plan o facturaci\u00f3n? Escr\u00edbenos a",
        credit_banner_until: "gratis hasta el",
        credit_banner_starts: "empieza el",
        credit_banner_lifetime: "de por vida",
        credit_source_coupon: "cup\u00f3n",
        credit_source_referral: "referido",
        credit_source_operator: "cortes\u00eda",
        credit_upgrade_note:
            "Tu cr\u00e9dito {tier} es gratis hasta el {date}. Si compras un plan " +
            "ahora no lo desperdicias: el tiempo pagado se suma y empieza cuando " +
            "termina el cr\u00e9dito.",
        credit_upgrade_lifetime:
            "Tu cr\u00e9dito {tier} no vence, as\u00ed que no necesitas comprar nada.",
        coupon_title: "\u00bfTienes un cup\u00f3n?",
        coupon_placeholder: "C\u00d3DIGO",
        coupon_apply: "Aplicar",
        coupon_invalid: "Ese c\u00f3digo no es v\u00e1lido o ya venci\u00f3.",
        coupon_already: "Ya usaste este c\u00f3digo.",
        coupon_error: "No se pudo aplicar el c\u00f3digo. Int\u00e9ntalo de nuevo.",
        features: {
            tasks_rewards: "Tareas y Recompensas",
            family_members: "Miembros de Familia",
            budget_accounts: "Cuentas de Presupuesto",
            transactions_month: "Transacciones / mes",
            reports_goals: "Reportes y Metas",
            recurring_transactions: "Transacciones Recurrentes",
            csv_import: "Importar CSV",
            ai_receipt_scan: "Escaneo de Recibos con IA",
            future_ai: "Futuras Funciones IA",
        },
    },
};

const l = i18n[lang] ?? i18n.en;

// Explains why a credited family still sees a price tag: the credit has an
// end date, and buying now is additive rather than wasted (PlanCreditService
// starts a same-or-lower-tier grant only once the paid period is over, and a
// paid plan simply outranks the credit while both run). Without this the
// buttons read as billing the family twice for what they already have.
const creditUpgradeNote = !isCreditFloored
    ? null
    : hasLifetimeCredit
        ? l.credit_upgrade_lifetime.replace(
              "{tier}", effectivePlanName.toUpperCase(),
          )
        : l.credit_upgrade_note
              .replace("{tier}", effectivePlanName.toUpperCase())
              .replace(
                  "{date}",
                  fmtDate(creditEndsIso, lang, user.timezone, {
                      year: "numeric", month: "long", day: "numeric",
                  }),
              );

// Feature comparison table data
const featureRows = [
    { label: l.features.tasks_rewards, free: { en: "Full", es: "Completo" }[lang], plus: { en: "Full", es: "Completo" }[lang], pro: { en: "Full", es: "Completo" }[lang] },
    { label: l.features.family_members, free: "4", plus: "8", pro: l.unlimited },
    { label: l.features.budget_accounts, free: "2", plus: "5", pro: l.unlimited },
    { label: l.features.transactions_month, free: "30", plus: "200", pro: l.unlimited },
    { label: l.features.reports_goals, free: null, plus: true, pro: true },
    { label: l.features.recurring_transactions, free: null, plus: "5", pro: l.unlimited },
    { label: l.features.csv_import, free: null, plus: true, pro: true },
    { label: l.features.ai_receipt_scan, free: null, plus: `15/${lang === "es" ? "mes" : "mo"}`, pro: l.unlimited },
    { label: l.features.future_ai, free: null, plus: { en: "Limited", es: "Limitado" }[lang], pro: { en: "Full", es: "Completo" }[lang] },
];

// Usage meters
const usageMeters: Array<{ label: string; current: number; limit: number | null }> = [];
if (usage) {
    if (usage.family_members !== undefined) {
        usageMeters.push({
            label: l.features.family_members,
            current: usage.family_members?.current ?? 0,
            limit: usage.family_members?.limit,
        });
    }
    if (usage.budget_accounts !== undefined) {
        usageMeters.push({
            label: l.features.budget_accounts,
            current: usage.budget_accounts?.current ?? 0,
            limit: usage.budget_accounts?.limit,
        });
    }
    if (usage.monthly_transactions !== undefined) {
        usageMeters.push({
            label: l.features.transactions_month,
            current: usage.monthly_transactions?.current ?? 0,
            limit: usage.monthly_transactions?.limit,
        });
    }
    if (usage.recurring_transactions !== undefined) {
        usageMeters.push({
            label: l.features.recurring_transactions,
            current: usage.recurring_transactions?.current ?? 0,
            limit: usage.recurring_transactions?.limit,
        });
    }
}

function renderCell(value: any): string {
    if (value === true) return "\u2713";
    if (value === null || value === false) return "\u2717";
    return String(value);
}

function cellClass(value: any): string {
    if (value === true) return "text-brand-mint-deep font-bold";
    if (value === null || value === false) return "text-brand-ink-soft";
    return "text-brand-ink font-medium";
}
---

<PageLayout
    title={l.title}
    headerClass="bg-gradient-to-br from-amber-600 to-orange-600"
    dark
    backClass="text-amber-200 hover:text-white"
    backHref="/parent/settings"
    backLabel={l.back}
    role={user.role}
    active="parent"
    lang={lang}
    mainClass="flex-1 px-4 py-6 space-y-6"
>
            {justUpgraded && (
                <div class="rounded-2xl border border-emerald-300 bg-emerald-50 p-4 text-emerald-800 font-semibold shadow-[var(--shadow-card)]" role="status">
                    ✅ {l.upgraded_banner}
                </div>
            )}
            {checkoutCancelled && (
                <div class="rounded-2xl border border-amber-300 bg-amber-50 p-4 text-amber-800 shadow-[var(--shadow-card)]" role="status">
                    {l.cancelled_banner}
                </div>
            )}

            <!-- Current Plan -->
            <section class="bg-brand-cream rounded-2xl p-5 shadow-[var(--shadow-card)] border border-brand-ink/10">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-brand-ink-soft">{l.current_plan}</p>
                        <h2 class="text-xl font-bold text-brand-ink capitalize">{effectivePlanName}</h2>
                    </div>
                    {isActive && !cancelAtPeriodEnd && (
                        <span class="px-3 py-1 text-xs font-semibold rounded-full bg-brand-mint/20 text-brand-mint-deep border border-brand-mint">
                            {l.active}
                        </span>
                    )}
                    {isActive && cancelAtPeriodEnd && (
                        <span class="px-3 py-1 text-xs font-semibold rounded-full bg-brand-sun/20 text-brand-sun-deep border border-brand-sun">
                            {l.cancel_scheduled}
                        </span>
                    )}
                    {isCancelled && (
                        <span class="px-3 py-1 text-xs font-semibold rounded-full bg-red-100 text-red-700 border border-red-200">
                            {l.cancelled}
                        </span>
                    )}
                </div>
                {cancelAtPeriodEnd && periodEndLabel && (
                    <p class="mt-3 text-sm text-brand-sun-deep bg-brand-sun/20 border border-brand-sun rounded-lg p-3">
                        {l.access_until} <strong>{periodEndLabel}</strong>.
                    </p>
                )}
            </section>

            <!-- Usage Meters -->
            {usageMeters.length > 0 && (
                <section class="bg-brand-cream rounded-2xl p-5 shadow-[var(--shadow-card)] border border-brand-ink/10">
                    <h2 class="text-lg font-bold text-brand-ink mb-4">{l.usage_title}</h2>
                    <div class="space-y-4">
                        {usageMeters.map((meter) => {
                            const isUnlimited = meter.limit === null || meter.limit === -1;
                            const pct = isUnlimited ? 0 : Math.min(100, Math.round((meter.current / meter.limit!) * 100));
                            const barColor = pct >= 90 ? "bg-red-500" : pct >= 70 ? "bg-brand-sun-deep" : "bg-brand-sky-deep";
                            return (
                                <div>
                                    <div class="flex justify-between text-sm mb-1">
                                        <span class="text-brand-ink-soft">{meter.label}</span>
                                        <span class="font-medium text-brand-ink">
                                            {meter.current} {l.of} {isUnlimited ? l.unlimited : meter.limit}
                                            {" "}<span class="text-brand-ink-soft text-xs">{l.this_month}</span>
                                        </span>
                                    </div>
                                    <div class="w-full bg-brand-cream-deep rounded-full h-2.5">
                                        <div
                                            class={`h-2.5 rounded-full transition-all ${barColor}`}
                                            style={`width: ${isUnlimited ? 5 : pct}%`}
                                        />
                                    </div>
                                </div>
                            );
                        })}
                    </div>
                </section>
            )}

            <!-- Active plan credits (coupons / referrals / operator courtesy) -->
            {credits.length > 0 && (
                <section class="rounded-2xl border border-emerald-300 bg-emerald-50 p-4 shadow-[var(--shadow-card)]">
                    <ul class="space-y-1 text-sm text-emerald-800">
                        {credits.map((c: any) => (
                            <li>
                                <strong class="uppercase">{c.tier}</strong>{" "}
                                {!isLive(c)
                                    ? `${l.credit_banner_starts} ${fmtDate(c.starts_at, lang, user.timezone, { year: "numeric", month: "long", day: "numeric" })}`
                                    : c.lifetime
                                        ? l.credit_banner_lifetime
                                        : `${l.credit_banner_until} ${fmtDate(c.ends_at, lang, user.timezone, { year: "numeric", month: "long", day: "numeric" })}`}
                                <span class="opacity-70">
                                    {" "}· {c.source === "coupon"
                                        ? l.credit_source_coupon
                                        : c.source === "referral"
                                            ? l.credit_source_referral
                                            : l.credit_source_operator}
                                </span>
                            </li>
                        ))}
                    </ul>
                </section>
            )}

            <!-- Plan Comparison Table -->
            <section class="bg-brand-cream rounded-2xl p-5 shadow-[var(--shadow-card)] border border-brand-ink/10 overflow-x-auto">
                <div class="flex flex-wrap items-start justify-between gap-2 mb-1">
                    <h2 class="text-lg font-bold text-brand-ink">{l.plan_comparison}</h2>
                    {showCurrencyToggle && (
                        <div class="flex items-center gap-1 bg-brand-cream-deep rounded-full p-1" role="group" aria-label={l.currency_toggle}>
                            {toggleCurrencies.map((cur) => (
                                <a
                                    href={currencyHref(cur)}
                                    class={`px-3 py-1 text-xs font-semibold rounded-full transition-colors ${selectedCurrency === cur ? "bg-brand-sky-deep text-white" : "text-brand-ink-soft hover:text-brand-ink"}`}
                                    aria-current={selectedCurrency === cur ? "true" : undefined}
                                >
                                    {cur === "MXN" ? "MX$" : "US$"}
                                </a>
                            ))}
                        </div>
                    )}
                </div>
                <p class="text-sm text-brand-ink-soft mb-4">{l.one_membership}</p>
                <table class="w-full text-sm">
                    <thead>
                        <tr class="border-b border-brand-ink/10">
                            <th class="text-left py-3 px-2 text-brand-ink-soft font-medium">{l.feature}</th>
                            <th class={`text-center py-3 px-2 ${effectivePlanName === "free" ? "bg-brand-sky/15 rounded-t-xl" : ""}`}>
                                <div class="font-bold text-brand-ink">{l.free}</div>
                                <div class="text-xs text-brand-ink-soft">{l.free}</div>
                                {effectivePlanName === "free" && (
                                    <span class="inline-block mt-1 px-2 py-0.5 text-[10px] font-semibold rounded-full bg-brand-sky/15 text-brand-sky-deep">
                                        {l.current_plan}
                                    </span>
                                )}
                            </th>
                            <th class={`text-center py-3 px-2 ${effectivePlanName === "plus" ? "bg-brand-sky/15 rounded-t-xl" : ""}`}>
                                <div class="font-bold text-brand-ink">{l.plus}</div>
                                <div class="text-xs text-brand-ink-soft">{price(plusPlan, "monthly") ?? "—"}{l.month} ({price(plusPlan, "annual") ?? "—"}{l.year})</div>
                                {effectivePlanName === "plus" && (
                                    <span class="inline-block mt-1 px-2 py-0.5 text-[10px] font-semibold rounded-full bg-brand-sky/15 text-brand-sky-deep">
                                        {l.current_plan}
                                    </span>
                                )}
                            </th>
                            <th class={`text-center py-3 px-2 ${effectivePlanName === "pro" ? "bg-brand-sky/15 rounded-t-xl" : ""}`}>
                                <div class="font-bold text-brand-ink">{l.pro}</div>
                                <div class="text-xs text-brand-ink-soft">{price(proPlan, "monthly") ?? "—"}{l.month} ({price(proPlan, "annual") ?? "—"}{l.year})</div>
                                {effectivePlanName === "pro" && (
                                    <span class="inline-block mt-1 px-2 py-0.5 text-[10px] font-semibold rounded-full bg-brand-sky/15 text-brand-sky-deep">
                                        {l.current_plan}
                                    </span>
                                )}
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        {featureRows.map((row, i) => (
                            <tr class={`border-b border-brand-ink/10 ${i % 2 === 0 ? "bg-brand-cream-deep/50" : ""}`}>
                                <td class="py-3 px-2 text-brand-ink">{row.label}</td>
                                <td class={`py-3 px-2 text-center ${cellClass(row.free)} ${effectivePlanName === "free" ? "bg-brand-sky/15/50" : ""}`}>
                                    {renderCell(row.free)}
                                </td>
                                <td class={`py-3 px-2 text-center ${cellClass(row.plus)} ${effectivePlanName === "plus" ? "bg-brand-sky/15/50" : ""}`}>
                                    {renderCell(row.plus)}
                                </td>
                                <td class={`py-3 px-2 text-center ${cellClass(row.pro)} ${effectivePlanName === "pro" ? "bg-brand-sky/15/50" : ""}`}>
                                    {renderCell(row.pro)}
                                </td>
                            </tr>
                        ))}
                    </tbody>
                </table>

                <!-- Upgrade / Cancel Buttons -->
                <div class="mt-6 flex flex-col sm:flex-row gap-3 justify-center">
                    {currentPlanName === "free" && (
                        <button
                            class="upgrade-btn px-6 py-2.5 bg-brand-sky-deep text-white text-sm font-semibold rounded-lg hover:bg-brand-sky-deep transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
                            data-plan="plus"
                            data-cycle="monthly"
                            data-currency={selectedCurrency}
                            disabled={!canCheckout(plusPlan)}
                        >
                            {l.upgrade} → {l.plus}
                        </button>
                    )}
                    {currentPlanName !== "pro" && (
                        <button
                            class="upgrade-btn px-6 py-2.5 bg-brand-coral-deep text-white text-sm font-semibold rounded-lg hover:bg-brand-coral-deep transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
                            data-plan="pro"
                            data-cycle="monthly"
                            data-currency={selectedCurrency}
                            disabled={!canCheckout(proPlan)}
                        >
                            {l.upgrade} → {l.pro}
                        </button>
                    )}
                    {isPaid && isActive && !cancelAtPeriodEnd && (
                        <button
                            id="cancel-sub-btn"
                            class="px-6 py-2.5 bg-brand-cream border border-red-200 text-red-600 text-sm font-semibold rounded-lg hover:bg-red-100 transition-colors"
                        >
                            {l.cancel}
                        </button>
                    )}
                </div>
                <p id="checkout-error" class="mt-3 hidden text-center text-sm font-semibold text-red-600" role="alert" data-prefix={l.checkout_error}></p>
                {creditUpgradeNote && (
                    <p class="mt-3 text-center text-xs text-brand-ink-soft">{creditUpgradeNote}</p>
                )}
                {upgradeUnavailable && (
                    <p class="mt-3 text-center text-xs text-brand-ink-soft">{l.coming_soon}</p>
                )}
            </section>

            <!-- Coupon redeem box -->
            <section class="bg-brand-cream rounded-2xl p-5 shadow-[var(--shadow-card)] border border-brand-ink/10">
                <h2 class="text-lg font-bold text-brand-ink">{l.coupon_title}</h2>
                <form id="coupon-form" class="mt-2 flex gap-2">
                    <input
                        id="coupon-code"
                        name="code"
                        required
                        maxlength="32"
                        autocomplete="off"
                        placeholder={l.coupon_placeholder}
                        class="flex-1 min-w-0 rounded-lg border border-brand-ink/20 bg-white px-3 py-2 text-sm text-brand-ink uppercase placeholder:normal-case focus:outline-none focus:ring-2 focus:ring-brand-sky-deep"
                    />
                    <button
                        type="submit"
                        class="px-4 py-2 bg-brand-sky-deep text-white text-sm font-semibold rounded-lg hover:bg-brand-sky-deep transition-colors"
                    >
                        {l.coupon_apply}
                    </button>
                </form>
                <p id="coupon-error" aria-live="polite" class="mt-2 hidden text-sm text-red-600"></p>
            </section>

            <!-- Support contact -->
            <p class="mt-6 text-center text-sm text-brand-ink-soft font-sans">
                {l.support_prompt}
                <a href="mailto:soporte@agent-ia.mx" class="font-semibold underline hover:text-brand-coral-deep">soporte@agent-ia.mx</a>
            </p>
</PageLayout>

<script define:vars={{ cancelConfirm: l.cancel_confirm, couponMsgs: { invalid: l.coupon_invalid, already: l.coupon_already, error: l.coupon_error } }}>
    document.addEventListener('astro:page-load', () => {
        const couponForm = document.getElementById('coupon-form');
        if (couponForm) {
            const errorEl = document.getElementById('coupon-error');
            couponForm.addEventListener('submit', async (e) => {
                e.preventDefault();
                errorEl.classList.add('hidden');
                const input = document.getElementById('coupon-code');
                // Trim only — the backend service normalizes case itself; the
                // input's `uppercase` class is cosmetic.
                const code = input.value.trim();
                // Write the trimmed value back: `required` accepts spaces, so a
                // whitespace-only entry would otherwise bail below with no
                // feedback at all. Emptying the field lets the browser's own
                // required-field bubble explain it, in the user's locale.
                input.value = code;
                if (!code) {
                    input.reportValidity();
                    return;
                }
                const submitBtn = couponForm.querySelector('button[type="submit"]');
                const originalText = submitBtn.textContent;
                submitBtn.disabled = true;
                submitBtn.textContent = '...';
                try {
                    const resp = await fetch('/api/subscriptions/coupons/redeem', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ code }),
                    });
                    if (resp.ok) {
                        // Reload so the banner, the current plan and the usage
                        // table all reflect the new entitlement in one pass. The
                        // button stays disabled on purpose — the page is leaving,
                        // and a second POST would 409 over a redemption that
                        // actually worked.
                        window.location.reload();
                        return;
                    }
                    // FastAPI wraps HTTPException detail: the wire shape is
                    // {"detail": {"error": "invalid_or_expired_coupon"}}.
                    const body = await resp.json().catch(() => null);
                    const errCode = body?.detail?.error;
                    errorEl.textContent =
                        errCode === 'invalid_or_expired_coupon' || resp.status === 404 ? couponMsgs.invalid
                        : errCode === 'already_redeemed' || resp.status === 409 ? couponMsgs.already
                        : couponMsgs.error;
                } catch {
                    errorEl.textContent = couponMsgs.error;
                }
                submitBtn.disabled = false;
                submitBtn.textContent = originalText;
                errorEl.classList.remove('hidden');
            });
        }

        const cancelBtn = document.getElementById('cancel-sub-btn');
        if (cancelBtn) {
            cancelBtn.addEventListener('click', async () => {
                if (!confirm(cancelConfirm)) return;
                try {
                    const res = await fetch('/api/subscriptions/cancel', { method: 'POST' });
                    if (res.ok) {
                        window.location.reload();
                    }
                } catch {
                    // silently fail
                }
            });
        }

        const errorEl = document.getElementById('checkout-error');
        const showCheckoutError = (detail) => {
            if (!errorEl) return;
            errorEl.textContent = `${errorEl.dataset.prefix}: ${detail}`;
            errorEl.classList.remove('hidden');
        };
        document.querySelectorAll('.upgrade-btn').forEach((btn) => {
            btn.addEventListener('click', async (evt) => {
                const target = evt.currentTarget;
                const plan = target.dataset.plan;
                const cycle = target.dataset.cycle || 'monthly';
                const currency = target.dataset.currency || 'MXN';
                const originalText = target.textContent;
                target.disabled = true;
                target.textContent = '...';
                errorEl?.classList.add('hidden');
                try {
                    const resp = await fetch('/api/subscriptions/checkout', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ plan_name: plan, billing_cycle: cycle, currency }),
                    });
                    if (!resp.ok) {
                        const err = await resp.json().catch(() => ({ detail: 'Error' }));
                        showCheckoutError(err.detail || resp.statusText);
                        target.disabled = false;
                        target.textContent = originalText;
                        return;
                    }
                    const data = await resp.json();
                    window.location.href = data.approval_url;
                } catch (e) {
                    showCheckoutError(String(e));
                    target.disabled = false;
                    target.textContent = originalText;
                }
            });
        });
    });
</script>
