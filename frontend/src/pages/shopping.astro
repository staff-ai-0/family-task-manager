---
import PageLayout from "@components/ui/PageLayout.astro";
import { apiFetch } from "../lib/api";

const token = Astro.cookies.get("access_token")?.value;
if (!token) return Astro.redirect("/login");
const lang = (Astro.cookies.get("lang")?.value ?? "es") as "en" | "es";

let errorMsg = "";

if (Astro.request.method === "POST") {
    const data = await Astro.request.formData();
    const action = data.get("action");
    const selected = Astro.url.searchParams.get("list");
    let redirectTo = "/shopping" + (selected ? `?list=${encodeURIComponent(selected)}` : "");

    if (action === "create_list") {
        const name = String(data.get("name") || "").trim();
        if (name) {
            const { ok, error } = await apiFetch("/api/shopping/lists", {
                method: "POST",
                token,
                body: JSON.stringify({ name }),
            });
            if (!ok) errorMsg = error || "Error";
        }
    } else if (action === "add_item") {
        const listId = data.get("list_id");
        const name = String(data.get("item_name") || "").trim();
        const qty = String(data.get("qty") || "").trim() || null;
        if (listId && name) {
            const { ok, error } = await apiFetch(
                `/api/shopping/lists/${listId}/items`,
                {
                    method: "POST",
                    token,
                    body: JSON.stringify({ name, qty }),
                },
            );
            if (!ok) errorMsg = error || "Error";
        }
    } else if (action === "toggle_item") {
        const itemId = data.get("item_id");
        const checked = data.get("checked") === "true";
        if (itemId) {
            const { ok, error } = await apiFetch(`/api/shopping/items/${itemId}`, {
                method: "PATCH",
                token,
                body: JSON.stringify({ is_checked: !checked }),
            });
            if (!ok) errorMsg = error || "Error";
        }
    } else if (action === "delete_item") {
        const itemId = data.get("item_id");
        if (itemId) {
            const { ok, error } = await apiFetch(`/api/shopping/items/${itemId}`, {
                method: "DELETE",
                token,
            });
            if (!ok) errorMsg = error || "Error";
        }
    } else if (action === "archive_list") {
        const listId = data.get("list_id");
        if (listId) {
            const { ok, error } = await apiFetch(`/api/shopping/lists/${listId}`, {
                method: "PATCH",
                token,
                body: JSON.stringify({ is_archived: true }),
            });
            if (!ok) errorMsg = error || "Error";
            // ?list= now points at a list that left the active set.
            else redirectTo = "/shopping";
        }
    } else if (action === "delete_list") {
        const listId = data.get("list_id");
        if (listId) {
            const { ok, error } = await apiFetch(`/api/shopping/lists/${listId}`, {
                method: "DELETE",
                token,
            });
            if (!ok) errorMsg = error || "Error";
            else redirectTo = "/shopping";
        }
    }
    // Post/Redirect/Get only on success — redirecting after a failure threw
    // errorMsg away and made every failed write look like it worked.
    if (!errorMsg) return Astro.redirect(redirectTo);
}

const [{ data: user }, { data: listsRaw }] = await Promise.all([
    apiFetch<any>("/api/auth/me", { token }),
    apiFetch<any[]>("/api/shopping/lists", { token }),
]);
if (!user) {
    Astro.cookies.delete("access_token", { path: "/" });
    return Astro.redirect("/login");
}
const lists: any[] = Array.isArray(listsRaw) ? listsRaw : [];

const selectedId =
    Astro.url.searchParams.get("list") || (lists[0]?.id ?? null);

let detail: any = null;
if (selectedId) {
    const { data } = await apiFetch<any>(
        `/api/shopping/lists/${selectedId}`,
        { token },
    );
    detail = data;
}

const labels = {
    title: lang === "es" ? "Compras" : "Shopping",
    subtitle:
        lang === "es"
            ? "Listas compartidas de la familia"
            : "Shared family lists",
    new_list_ph: lang === "es" ? "Nueva lista (e.g. Costco)" : "New list (e.g. Costco)",
    add: lang === "es" ? "Agregar" : "Add",
    add_item_ph: lang === "es" ? "Agregar artículo" : "Add item",
    qty_ph: lang === "es" ? "Cant." : "Qty",
    empty_lists:
        lang === "es"
            ? "Aún no hay listas. Crea una arriba."
            : "No lists yet. Create one above.",
    empty_items:
        lang === "es" ? "Lista vacía. Agrega algo." : "Empty list. Add something.",
    pending: lang === "es" ? "pendientes" : "pending",
    archive: lang === "es" ? "Archivar" : "Archive",
    delete: lang === "es" ? "Eliminar" : "Delete",
    confirm_delete: lang === "es" ? "¿Borrar lista?" : "Delete list?",
    err_toggle: lang === "es" ? "No se pudo actualizar" : "Could not update",
    err_delete: lang === "es" ? "No se pudo eliminar" : "Could not delete",
};
---

<PageLayout
    title={`🛒 ${labels.title}`}
    headerClass="bg-gradient-to-br from-emerald-500 to-teal-500"
    dark
    role={user.role}
    active="tasks"
    lang={lang}
    mainClass="flex-1 px-4 py-6 space-y-4"
>
    <p slot="header-extra" class="text-emerald-100 text-sm mt-1">{labels.subtitle}</p>
            {errorMsg && (
                <div class="p-3 bg-red-100 border border-red-200 text-red-700 text-sm rounded-xl">
                    {errorMsg}
                </div>
            )}

            <form method="POST" class="bg-brand-cream rounded-2xl p-3 border border-brand-ink/10 shadow-[var(--shadow-card)] flex gap-2">
                <input type="hidden" name="action" value="create_list" />
                <input
                    type="text"
                    name="name"
                    required
                    maxlength="120"
                    placeholder={labels.new_list_ph}
                    class="flex-1 px-3 py-2 rounded-lg border border-brand-ink/20 text-sm focus:ring-2 focus:ring-brand-sky-deep outline-none"
                />
                <button
                    type="submit"
                    class="px-4 py-2 rounded-lg bg-brand-ink text-brand-cream text-sm font-semibold hover:bg-brand-ink-soft active:scale-95"
                >
                    {labels.add}
                </button>
            </form>

            {lists.length === 0 ? (
                <div class="bg-brand-cream rounded-2xl p-8 text-center border border-brand-ink/10 shadow-[var(--shadow-card)]">
                    <p class="text-brand-ink-soft text-sm">{labels.empty_lists}</p>
                </div>
            ) : (
                <div class="flex gap-2 overflow-x-auto pb-1 -mx-4 px-4">
                    {lists.map((l: any) => (
                        <a
                            href={`/shopping?list=${l.id}`}
                            class={`flex-shrink-0 px-4 py-2 rounded-full text-sm font-semibold whitespace-nowrap border-2 transition-all ${
                                l.id === selectedId
                                    ? "bg-brand-ink text-brand-cream border-brand-ink"
                                    : "bg-brand-cream text-brand-ink border-brand-ink/20 hover:border-brand-ink"
                            }`}
                        >
                            {l.name}
                            <span
                                id={l.id === selectedId ? "chip-pending" : undefined}
                                class={`ml-1.5 px-1.5 py-0.5 text-xs rounded-full bg-brand-coral text-white${
                                    l.pending_count > 0 ? "" : " hidden"
                                }`}
                            >
                                {l.pending_count}
                            </span>
                        </a>
                    ))}
                </div>
            )}

            {detail && (
                <section class="bg-brand-cream rounded-2xl border border-brand-ink/10 shadow-[var(--shadow-card)] overflow-hidden">
                    <div class="p-4 border-b border-brand-ink/10 flex items-center justify-between gap-2">
                        <div>
                            <h2 class="font-bold text-brand-ink text-lg">{detail.name}</h2>
                            <p class="text-xs text-brand-ink-soft">
                                <span id="item-count">{detail.item_count}</span> ·
                                <span id="pending-count">{detail.pending_count}</span> {labels.pending}
                            </p>
                        </div>
                        <div class="flex gap-1">
                            <form method="POST">
                                <input type="hidden" name="action" value="archive_list" />
                                <input type="hidden" name="list_id" value={detail.id} />
                                <button
                                    type="submit"
                                    class="px-2.5 py-1.5 rounded-lg text-xs font-semibold bg-brand-cream-deep text-brand-ink-soft hover:bg-brand-ink/10"
                                >
                                    {labels.archive}
                                </button>
                            </form>
                            <form method="POST" onsubmit={`return confirm('${labels.confirm_delete}')`}>
                                <input type="hidden" name="action" value="delete_list" />
                                <input type="hidden" name="list_id" value={detail.id} />
                                <button
                                    type="submit"
                                    class="px-2.5 py-1.5 rounded-lg text-xs font-semibold bg-red-100 text-red-700 hover:bg-red-200"
                                >
                                    {labels.delete}
                                </button>
                            </form>
                        </div>
                    </div>

                    <form method="POST" class="p-3 border-b border-brand-ink/10 flex gap-2">
                        <input type="hidden" name="action" value="add_item" />
                        <input type="hidden" name="list_id" value={detail.id} />
                        <input
                            type="text"
                            name="item_name"
                            required
                            maxlength="200"
                            placeholder={labels.add_item_ph}
                            class="flex-1 px-3 py-2 rounded-lg border border-brand-ink/20 text-sm focus:ring-2 focus:ring-brand-sky-deep outline-none"
                        />
                        <input
                            type="text"
                            name="qty"
                            maxlength="40"
                            placeholder={labels.qty_ph}
                            class="w-20 px-3 py-2 rounded-lg border border-brand-ink/20 text-sm focus:ring-2 focus:ring-brand-sky-deep outline-none"
                        />
                        <button
                            type="submit"
                            class="px-4 py-2 rounded-lg bg-brand-sun-deep text-brand-ink text-sm font-semibold hover:bg-brand-sun active:scale-95"
                        >
                            +
                        </button>
                    </form>

                    <!-- Both states always render: the island toggles them when
                         the last item is deleted, instead of reloading. -->
                    <p
                        id="items-empty"
                        class={`text-brand-ink-soft text-sm text-center py-8${detail.items.length ? " hidden" : ""}`}
                    >
                        {labels.empty_items}
                    </p>
                    <ul
                        id="items-list"
                        class={`divide-y divide-brand-ink/10${detail.items.length ? "" : " hidden"}`}
                    >
                        {detail.items.map((item: any) => (
                            <li
                                class="flex items-center gap-2 p-3"
                                data-item-id={item.id}
                                data-checked={String(item.is_checked)}
                            >
                                <form method="POST" data-toggle-form class="flex-1 flex items-center gap-3">
                                    <input type="hidden" name="action" value="toggle_item" />
                                    <input type="hidden" name="item_id" value={item.id} />
                                    <input type="hidden" name="checked" data-checked-field value={String(item.is_checked)} />
                                    <button
                                        type="submit"
                                        data-check-btn
                                        class={`w-6 h-6 rounded-md border-2 flex items-center justify-center flex-shrink-0 transition-all ${
                                            item.is_checked
                                                ? "bg-brand-mint border-brand-mint-deep text-brand-ink"
                                                : "border-brand-ink/30 hover:border-brand-ink"
                                        }`}
                                        aria-label={item.is_checked ? "Uncheck" : "Check"}
                                    >
                                        {item.is_checked && (
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                                            </svg>
                                        )}
                                    </button>
                                    <div
                                        data-item-label
                                        class={`flex-1 text-sm ${item.is_checked ? "line-through text-brand-ink-soft" : "text-brand-ink"}`}
                                    >
                                        <span class="font-medium">{item.name}</span>
                                        {item.qty && (
                                            <span class="ml-2 text-xs text-brand-ink-soft">· {item.qty}</span>
                                        )}
                                    </div>
                                </form>
                                <form method="POST" data-delete-item-form>
                                    <input type="hidden" name="action" value="delete_item" />
                                    <input type="hidden" name="item_id" value={item.id} />
                                    <button
                                        type="submit"
                                        class="text-brand-ink-soft hover:text-red-600 text-lg leading-none px-2"
                                        aria-label="Delete"
                                    >
                                        ×
                                    </button>
                                </form>
                            </li>
                        ))}
                    </ul>
                </section>
            )}
</PageLayout>

<script>
/**
 * Check-off and delete run optimistically. In the store this is the most
 * repeated interaction in the app, and the form POST → redirect → SSR
 * round-trip cost a full reload (and the scroll position) per tap.
 *
 * The forms stay in the markup and keep working without JS — this island only
 * intercepts `submit`, so a failed hydration degrades to the old behaviour.
 */
import { mutate } from "../lib/mutate";

const es = (document.cookie.match(/(?:^|;\s*)lang=([^;]+)/)?.[1] ?? "es") === "es";
const ERR_TOGGLE = es ? "No se pudo actualizar" : "Could not update";
const ERR_DELETE = es ? "No se pudo eliminar" : "Could not delete";

const CHECK_SVG =
    '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">' +
    '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg>';

/** Adjust a rendered integer. `hideAtZero` is for the list chip badge, which
 *  the server omits entirely when nothing is pending. */
function bump(el: HTMLElement | null, delta: number, hideAtZero = false): void {
    if (!el) return;
    const n = Math.max(0, (parseInt(el.textContent ?? "", 10) || 0) + delta);
    el.textContent = String(n);
    if (hideAtZero) el.classList.toggle("hidden", n === 0);
}

function bumpPending(delta: number): void {
    bump(document.getElementById("pending-count"), delta);
    bump(document.getElementById("chip-pending"), delta, true);
}

function syncEmptyState(): void {
    const list = document.getElementById("items-list");
    const empty = document.getElementById("items-empty");
    const has = (list?.childElementCount ?? 0) > 0;
    list?.classList.toggle("hidden", !has);
    empty?.classList.toggle("hidden", has);
}

function paintItem(li: HTMLElement, checked: boolean): void {
    li.dataset.checked = String(checked);
    const btn = li.querySelector<HTMLButtonElement>("[data-check-btn]");
    if (btn) {
        btn.className =
            "w-6 h-6 rounded-md border-2 flex items-center justify-center flex-shrink-0 transition-all " +
            (checked
                ? "bg-brand-mint border-brand-mint-deep text-brand-ink"
                : "border-brand-ink/30 hover:border-brand-ink");
        btn.innerHTML = checked ? CHECK_SVG : "";
        btn.setAttribute("aria-label", checked ? "Uncheck" : "Check");
    }
    const label = li.querySelector<HTMLElement>("[data-item-label]");
    if (label) {
        label.className =
            "flex-1 text-sm " +
            (checked ? "line-through text-brand-ink-soft" : "text-brand-ink");
    }
    // The POST fallback sends the PRE-toggle state; keep it truthful so a
    // later no-JS submit of this same row still flips the right way.
    const field = li.querySelector<HTMLInputElement>("[data-checked-field]");
    if (field) field.value = String(checked);
}

document.addEventListener("submit", async (e) => {
    const form = (e.target as HTMLElement)?.closest?.("form");
    if (!form) return;
    const isToggle = form.matches("[data-toggle-form]");
    if (!isToggle && !form.matches("[data-delete-item-form]")) return;

    const li = form.closest<HTMLElement>("[data-item-id]");
    const itemId = li?.dataset.itemId;
    if (!li || !itemId) return;
    e.preventDefault();

    const wasChecked = li.dataset.checked === "true";

    if (isToggle) {
        const next = !wasChecked;
        await mutate(`/api/shopping/items/${itemId}`, {
            method: "PATCH",
            body: { is_checked: next },
            optimistic: () => {
                paintItem(li, next);
                bumpPending(next ? -1 : 1);
            },
            revert: () => {
                paintItem(li, wasChecked);
                bumpPending(next ? 1 : -1);
            },
            errorFallback: ERR_TOGGLE,
        });
        return;
    }

    // Captured before removal so the revert can put the row back in place.
    const parent = li.parentElement;
    const after = li.nextElementSibling;
    await mutate(`/api/shopping/items/${itemId}`, {
        method: "DELETE",
        optimistic: () => {
            li.remove();
            bump(document.getElementById("item-count"), -1);
            if (!wasChecked) bumpPending(-1);
            syncEmptyState();
        },
        revert: () => {
            parent?.insertBefore(li, after);
            bump(document.getElementById("item-count"), 1);
            if (!wasChecked) bumpPending(1);
            syncEmptyState();
        },
        errorFallback: ERR_DELETE,
    });
});
</script>
