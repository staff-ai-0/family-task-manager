---
/**
 * Guía de usuario pública — Español. Renderiza docs/USER_GUIDE_ES.md dentro del
 * GuideShell compartido (hero + búsqueda + TOC automática + estilos). Enlazada
 * desde el welcome email y en el allowlist publicRoutes del middleware. La
 * versión en inglés está en /help.
 */
import GuideShell from "../components/GuideShell.astro";
// docs/ está montado read-only en /app/docs dentro del container del frontend.
import TourHub from "../components/TourHub.astro";
import SupportCta from "../components/SupportCta.astro";
import { apiFetch } from "../lib/api";

// Both guide pages are public. A signed-in reader also gets the replay hub, so
// resolve the viewer when a token is present and fall back to null otherwise —
// a failed lookup must not take the public guide down with it.
const token = Astro.cookies.get("access_token")?.value;
let tourUser: any = null;
if (token) {
    const { data, ok } = await apiFetch<any>("/api/auth/me", { token });
    if (ok) tourUser = data;
}

import { Content as GuideContent } from "../../docs/USER_GUIDE_ES.md";
---

<GuideShell
    title="Guía de usuario — Family Task Manager"
    description="Centro de ayuda de Family Task Manager: guías paso a paso para configurar tu familia, crear tareas y quehaceres, dar puntos y recompensas, y llevar el presupuesto familiar."
    lang="es"
    alternates={{ es: "/ayuda", en: "/help" }}
    backHref="/"
    backLabel="← Volver al inicio"
    toggleHref="/help"
    toggleLabel="English"
    heroTitle="Centro de Ayuda"
    heroSub="Guías para cada parte de Family Task Manager"
    searchPlaceholder="Buscar temas…"
    searchAria="Buscar en la guía del usuario"
    contentsLabel="Contenido"
    noResultsText="Ningún tema coincide con tu búsqueda."
    tocAria="Tabla de contenidos"
    privacyLabel="Aviso de Privacidad"
    termsLabel="Términos y Condiciones"
    supportLabel="Contactar soporte"
>
    <TourHub slot="before-content" lang="es" user={tourUser} />
    <SupportCta slot="before-content" lang="es" user={tourUser} />
    <GuideContent />
</GuideShell>
